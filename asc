#!/usr/bin/env bash
# asc — autoswitch control. Bilingual (RU/EN) dialog interface.
# Navigation: Enter — select, ESC — back.
#
#   asc                 menu
#   asc start|stop|restart|status
#   asc enable|disable  autostart
#   asc config          settings
#   asc log             journal

set -u

SERVICE="autoswitch"
CONFIG="/etc/autoswitch/config"
UW="/etc/autoswitch/user_words.txt"
LEARNED="/etc/autoswitch/learned.txt"

# --- словарь: US-форма против читаемого вида ---------------------------
# Ключ в learned.txt хранится в US-форме (латинскими клавишами): он должен
# совпадать с тем, что реально приходит с клавиатуры. Человеку же слово
# показываем так, как оно выглядит на экране: запись `bltt ru` — это «идее».
# Таблицы взяты из asc-gui намеренно: вид в консоли и в окне обязан
# совпадать, иначе одно и то же слово выглядит в двух местах по-разному.
_PY_KB='
KB_US = "qwertyuiop[]asdfghjkl;\x27zxcvbnm,./`"
KB_RU = "йцукенгшщзхъфывапролджэячсмитьбю.ё"
US2RU = dict(zip(KB_US, KB_RU))
RU2US = dict(zip(KB_RU, KB_US))
'

# слово в любой раскладке -> US-форма (для записи в файл)
learned_to_us() {
    python3 -c "$_PY_KB"'
import sys
print("".join(RU2US.get(c, c) for c in sys.argv[1].lower()))
' "$1" 2>/dev/null || printf '%s' "$1"
}

# Показать словарь читаемо. Второй аргумент "plain" — без отступов и
# выравнивания, пригодный для правки в редакторе.
learned_show() {
    python3 -c "$_PY_KB"'
import sys
plain = len(sys.argv) > 2 and sys.argv[2] == "plain"
rows = []
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        for ln in f:
            s = ln.strip()
            if not s or s.startswith("#"):
                continue
            parts = s.replace("\t", " ").split()
            if not parts:
                continue
            form = parts[0]
            lang = parts[1].lower() if len(parts) > 1 else "us"
            if lang not in ("ru", "us"):
                lang = "us"
            word = ("".join(US2RU.get(c, c) for c in form.lower())
                    if lang == "ru" else form.lower())
            rows.append((word, lang))
except OSError:
    pass
width = max([len(r[0]) for r in rows] + [0])
# Порядок не меняем: показываем как лежит в файле — так же делает окно
# asc-gui. Сортировка ставила латиницу раньше кириллицы, и один и тот же
# словарь выглядел в консоли и в окне по-разному.
for word, lang in rows:
    if plain:
        print("%s %s" % (word, lang))
    else:
        print("  %-*s  %s" % (width, word, lang))
' "$1" "${2:-}" 2>/dev/null
}

# Читаемый файл -> US-форма на stdout (для записи через asc-helper).
learned_to_file() {
    python3 -c "$_PY_KB"'
import sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        for ln in f:
            s = ln.strip()
            if not s or s.startswith("#"):
                continue
            parts = s.replace("\t", " ").split()
            if not parts:
                continue
            word = parts[0]
            lang = parts[1].lower() if len(parts) > 1 else "us"
            if lang not in ("ru", "us"):
                lang = "us"
            us = "".join(RU2US.get(c, c) for c in word.lower())
            print("%s\t%s" % (us, lang))
except OSError:
    pass
' "$1" 2>/dev/null
}

# Правка словаря в человеческом виде — как в окне asc-gui.
# Прямая правка learned.txt не годится: там лежит US-форма, и слово
# «идее» выглядит как «bltt» — пользователь не понимает, что правит.
# Поэтому отдаём редактору читаемую копию с той же подсказкой, что в
# окне, а на выходе переводим обратно и записываем тем же помощником —
# нормализация формата остаётся в одном месте.
learned_edit() {
    local tmp helper
    tmp="$(mktemp)" || return 1
    {
        # В окне абзац-пояснение стоит над полем правки. В редакторе
        # отдельной области нет, поэтому кладём его теми же словами, но
        # комментарием — при чтении строки с # всё равно отбрасываются.
        # перенос делаем питоном: fold считает БАЙТЫ, а кириллица
        # многобайтовая — строки выходили вдвое короче нужного
        printf '%b' "$(t td_hint)" | python3 -c 'import sys, textwrap
t = sys.stdin.read().strip()
for ln in textwrap.wrap(t, 72) or [""]:
    print("# " + ln)'
        echo
        printf '%b\n\n' "$(t td_file_hint)"
        learned_show "$LEARNED" plain
    } > "$tmp"
    "$EDITOR_BIN" "$tmp"
    helper="$(command -v asc-helper 2>/dev/null || echo /usr/local/bin/asc-helper)"
    if [ -x "$helper" ]; then
        learned_to_file "$tmp" | "$helper" write-learned
    else
        { echo "# autoswitch: мой словарь (US-форма<TAB>ru|us)."
          learned_to_file "$tmp"; } > "$LEARNED"
    fi
    rm -f "$tmp"
}
# Домашняя папка ТОГО, КТО ЗАПУСТИЛ, а не root: asc перезапускает себя
# через sudo, и $HOME становится /root. Из-за этого журнал искали в
# /root/Applications — там его нет и быть не может, служба пишет его в
# домашнюю папку пользователя. Определяется один раз, здесь, потому что
# путь нужен и до получения прав, и после.
user_home() {
    local h=""
    if [ -n "${SUDO_USER:-}" ]; then
        h="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)"
    elif [ -n "${PKEXEC_UID:-}" ]; then
        h="$(getent passwd "$PKEXEC_UID" 2>/dev/null | cut -d: -f6)"
    else
        h="$(getent passwd "${USER:-$(id -un)}" 2>/dev/null | cut -d: -f6)"
    fi
    [ -n "$h" ] || h="$HOME"
    printf '%s' "$h"
}

# Журнал рядом с исходниками, в домашней папке — доступен без sudo.
LOGFILE="$(user_home)/Applications/autoswitch.logs/autoswitch.log"

# Сказать индикатору обновиться сразу после действий со службой: он
# опрашивает состояние раз в несколько секунд и иначе показал бы перезапуск
# с задержкой. Если индикатор не запущен — тихо ничего не делаем.
poke_indicator() {
    # маячок для GNOME-расширения: оно следит за этим файлом и показывает
    # перезапуск в панели (напрямую до расширения не достучаться)
    : > "${XDG_RUNTIME_DIR:-/tmp}/autoswitch.beacon" 2>/dev/null || true
    _sock="${XDG_RUNTIME_DIR:-/tmp}/autoswitch-indicator.sock"
    [ -S "$_sock" ] || return 0
    printf 'refresh' | timeout 1 socat - "UNIX-CONNECT:$_sock" 2>/dev/null \
        || python3 -c "
import socket,sys
try:
    c=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); c.settimeout(0.5)
    c.connect('$_sock'); c.sendall(b'refresh'); c.close()
except Exception: pass" 2>/dev/null
    return 0
}
