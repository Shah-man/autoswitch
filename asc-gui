    # ── синхронизация колонок ─────────────────────────────────────────
    def _excl_toggle(self, cls, on, name=None, manual=False):
        """Единая точка правды: правая колонка = состав исключений."""
        if on and cls not in self.ex_added:
            self.ex_names.setdefault(cls, name or cls)
            self._excl_added_row(cls, manual)
        elif not on and cls in self.ex_added:
            row = self.ex_added.pop(cls)
            self.ex_added_box.remove(row)
        chk = self.ex_checks.get(cls)
        if chk is not None and chk.get_active() != on:
            self._ex_sync = True
            chk.set_active(on)
            self._ex_sync = False
        self._excl_refresh_count()

    def _excl_added_row(self, cls, manual=False):
        row = Gtk.ListBoxRow()
        hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        nm = self.ex_names.get(cls, cls)
        txt = GLib.markup_escape_text(nm)
        if manual:
            txt += ' <span foreground="%s" size="8500">(%s)</span>' % (
                GRAY, self.t('ex_manual'))
        lb = Gtk.Label()
        lb.set_markup('<span foreground="%s">%s</span>' % (FG, txt))
        lb.set_halign(Gtk.Align.START)
        lb.set_ellipsize(Pango.EllipsizeMode.END)
        hb.pack_start(lb, True, True, 0)
        rm = Gtk.Button()
        rm.get_style_context().add_class('mini')
        rm.set_tooltip_text(self.t('ex_rm_hint'))
        rm.add(self._lbl('\u2715', RED, bold=True))
        rm.connect('clicked', lambda _b, c=cls: self._excl_toggle(c, False))
        hb.pack_end(rm, False, False, 0)
        row.add(hb)
        row._cls = cls
        row._btn = rm
        self._clickable(row, rm)
        self.ex_added[cls] = row
        self.ex_added_box.add(row)
        self.ex_added_box.show_all()
