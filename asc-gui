    def _show_techdict(self):
        # Читаем learned.txt (US-форма) и показываем в человеческом виде:
        # «идее   ru» вместо «bltt   ru». При сохранении конвертируем назад.
        lines = []
        try:
            with open(LEARNED) as f:
                for ln in f:
                    s = ln.strip()
                    if not s or s.startswith('#'):
                        continue
                    parts = s.replace('\t', ' ').split()
                    if not parts:
                        continue
                    form = parts[0]
                    lang = parts[1].lower() if len(parts) > 1 else 'us'
                    if lang not in ('ru', 'us'):
                        lang = 'us'
                    lines.append('%s\t%s' % (us_to_display(form, lang), lang))
        except Exception:
            pass
        header = self.t('td_file_hint') + '\n\n'
        self.td_buf.set_text(header + '\n'.join(lines) + ('\n' if lines else ''))
        self._nav_to('techdict')
        GLib.idle_add(self.td_view.grab_focus)

    def _td_save(self):
        s, e = self.td_buf.get_bounds()
        text = self.td_buf.get_text(s, e, True)
        # Конвертируем человеческий вид обратно в US-форму для learned.txt
        out = []
        for ln in text.splitlines():
            st = ln.strip()
            if not st or st.startswith('#'):
                continue
            parts = st.replace('\t', ' ').split()
            if not parts:
                continue
            word = parts[0]
            lang = parts[1].lower() if len(parts) > 1 else 'us'
            if lang not in ('ru', 'us'):
                lang = 'us'
            out.append('%s\t%s' % (display_to_us(word), lang))
        payload = '\n'.join(out) + ('\n' if out else '')
        try:
            run(['pkexec', HELPER, 'write-learned'], input_text=payload)
        except Exception:
            pass
        self._nav_back()
        self._show_toast(self.t('saved'))


def _single_instance():
    """Один экземпляр GUI на пользователя.

    Держим unix-сокет в runtime-каталоге. Если он уже кем-то слушается —
    значит окно открыто: стучимся туда, чтобы его подняли, и выходим.
    Возвращает слушающий сокет либо None, если запускаться не нужно.
    """
    path = os.path.join(GLib.get_user_runtime_dir() or '/tmp',
                        'autoswitch-gui.sock')
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        probe.connect(path)
        probe.sendall(b'present')
        return None
    except OSError:
        pass
    finally:
        try:
            probe.close()
        except OSError:
            pass
    # сокет остался от упавшего процесса — убираем и занимаем сами
    try:
        os.unlink(path)
    except OSError:
        pass
    try:
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(path)
        srv.listen(5)
        srv.setblocking(False)
    except OSError:
        return None
    atexit.register(lambda: os.path.exists(path) and os.unlink(path))
    return srv


def main():
    GLib.set_prgname('autoswitch')
    GLib.set_application_name('Autoswitch')
    srv = _single_instance()
    if srv is None:
        sys.exit(0)
    win = AscGui()
    win.attach_ipc(srv)
    win.connect('destroy', Gtk.main_quit)
    win.show_all()
    win.bottom_bar.hide()
    win.about_bar.hide()
    GLib.idle_add(win._restore_window_state)
    Gtk.main()


if __name__ == '__main__':
    main()
