        self.lang = detect_lang()
        # запомненный размер окна
        w, h = self._load_size()
        self.set_default_size(w, h)
        self._normal_size = (w, h)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name('autoswitch')
        geo = Gdk.Geometry()
        geo.min_width, geo.min_height = MIN_W, MIN_H
        self.set_geometry_hints(None, geo, Gdk.WindowHints.MIN_SIZE)
        self._apply_css()
        # Свой заголовок (CSD) нужен там, где системный рисуется светлой
        # темой WM и текст в нём почти не виден. На KDE так делать нельзя:
        # KWin рисует нормальный тёмный заголовок сам, а кнопки GTK-шапки
        # там остаются пустыми квадратами — значков для них в теме нет.
        desk = (os.environ.get('XDG_CURRENT_DESKTOP', '')
                + ' ' + os.environ.get('XDG_SESSION_DESKTOP', '')).upper()
        self._own_titlebar = 'KDE' not in desk and 'PLASMA' not in desk
        try:
            if not self._own_titlebar:
                raise RuntimeError('оставляем заголовок оконному менеджеру')
            hb = Gtk.HeaderBar()
            hb.set_show_close_button(True)
            hb.set_title('Autoswitch')
            hb.get_style_context().add_class('titlebar')
            self.set_titlebar(hb)
            self.headerbar = hb
        except Exception:
            self.headerbar = None
        self.tiles = []
        self.focus_idx = 0
        self._save_id = None
        self._about_mode = False
        self._nav = ['main']   # стек истории экранов, как уровни меню в asc
        self._grids = {}       # имя сетки -> (Gtk.Grid, список плиток)
        self._compact = []     # подписи кнопок шапки: полная / значок
