    # ── навигация клавиатурой (WASD + стрелки) ────────────────────────
    def _focus_tile(self, idx):
        if 0 <= idx < len(self.tiles):
            self.focus_idx = idx
            self.tiles[idx].grab_focus()
        return False

    def _in_text_widget(self):
        """В поле ввода буквы должны печататься, а не двигать фокус."""
        w = self.get_focus()
        return isinstance(w, (Gtk.Entry, Gtk.TextView, Gtk.SearchEntry))

    def _wasd_dir(self, event):
        """WASD в направление. Работает и в русской раскладке (цфыв)."""
        ch = event.string.lower() if event.string else ''
        name = (Gdk.keyval_name(event.keyval) or '').lower()
        for src in (ch, name):
            if src in ('w', '\u0446'):
                return 'up'
            if src in ('s', '\u044b'):
                return 'down'
            if src in ('a', '\u0444'):
                return 'left'
            if src in ('d', '\u0432'):
                return 'right'
        return None

    def _on_key(self, _w, event):
        cur = self.stack.get_visible_child_name()
        key = event.keyval

        if key == Gdk.KEY_Escape:
            if cur != 'main':
                self._nav_back()
                return True
            return False

        in_text = self._in_text_widget()
        d = None if in_text else self._wasd_dir(event)

        if cur == 'main':
            return self._nav_tiles(event, key, d)

        # Enter — как пробел: жмёт кнопку или отмечает галочку под рамкой
        if not in_text and key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if self._activate_focused():
                return True
        # если рамка стоит на строке целиком, пробел GTK не доносит до галочки
        if not in_text and key in (Gdk.KEY_space, Gdk.KEY_KP_Space) \
                and isinstance(self.get_focus(), Gtk.ListBoxRow):
            if self._activate_focused():
                return True

        arrow = {Gdk.KEY_Up: 'up', Gdk.KEY_Down: 'down',
                 Gdk.KEY_Left: 'left', Gdk.KEY_Right: 'right'}.get(key)
        w = self.get_focus()
        if isinstance(w, Gtk.TextView):
            # в редакторе стрелки двигают курсор по тексту
            arrow = None
        elif isinstance(w, Gtk.Entry) and arrow in ('left', 'right'):
            # в поле ввода влево/вправо — каретке, вверх/вниз — навигации
            arrow = None

        move = d or arrow
        if move is None:
            return False
        dirs = {
            'up': Gtk.DirectionType.UP,
            'down': Gtk.DirectionType.DOWN,
            'left': Gtk.DirectionType.LEFT,
            'right': Gtk.DirectionType.RIGHT,
        }
        before = self.get_focus()
        self.child_focus(dirs[move])
        if self.get_focus() is before:
            # список удерживает фокус на крайней строке — выходим табом
            self.child_focus(Gtk.DirectionType.TAB_BACKWARD
                             if move in ('up', 'left')
                             else Gtk.DirectionType.TAB_FORWARD)
        return True

    def _nav_tiles(self, event, key, d):
        cols = 2
        rows = (len(self.tiles) + 1) // cols
        i = self.focus_idx
        r, c = i // cols, i % cols
        if key == Gdk.KEY_Right or d == 'right':
            c = min(c + 1, cols - 1)
        elif key == Gdk.KEY_Left or d == 'left':
            c = max(c - 1, 0)
        elif key == Gdk.KEY_Down or d == 'down':
            r = min(r + 1, rows - 1)
        elif key == Gdk.KEY_Up or d == 'up':
            r = max(r - 1, 0)
        elif key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space):
            if 0 <= i < len(self.tiles):
                self.tiles[i].clicked()
            return True
        else:
            return False
        new = r * cols + c
        if new >= len(self.tiles):
            new = len(self.tiles) - 1
        self._focus_tile(new)
        return True

    def _nav_to(self, name):
        """Перейти на экран, запомнив текущий в истории (уровень вниз)."""
        cur = self.stack.get_visible_child_name()
        if cur != name:
            self._nav.append(cur)
        self.stack.set_visible_child_name(name)

    def _nav_back(self):
        """Вернуться на уровень назад (Назад/Esc), как в asc."""
        self._excl_cancel_catch()
        if len(self._nav) > 1:
            prev = self._nav.pop()
        else:
            prev = 'main'
        self.stack.set_visible_child_name(prev)
        if prev == 'main':
            self._focus_tile(self.focus_idx)

    def _go_main(self):
        self._nav = ['main']
        self.stack.set_visible_child_name('main')
        self._focus_tile(self.focus_idx)

    # ── вывод ─────────────────────────────────────────────────────────
    def show_output(self, text, title, colorize=False, about=False,
                    to_end=False, with_clear=False):
        self._about_mode = about
        # кнопка очистки — только на экране журнала
        if hasattr(self, 'btn_clearlog'):
            if with_clear:
                self.btn_clearlog.show()
            else:
                self.btn_clearlog.hide()
        if about:
            self.out_scroll.set_vexpand(True)
            self.bottom_bar.show()
            self.about_bar.show_all()
        else:
            self.out_scroll.set_vexpand(True)
            self.bottom_bar.hide()
            self.about_bar.hide()
        self.out_title.set_markup(
            '<span foreground="%s" weight="bold">%s</span>' % (CYAN, title))
        self.out_buf.set_text('')
        if colorize:
            self._insert_colored(text)
        else:
            self.out_buf.set_text(text)
        self._nav_to('output')
        # фокус — на «Назад»: и видно, где он, и случайный Enter просто
        # вернёт в меню, а не сотрёт журнал
        if hasattr(self, 'out_back'):
            GLib.idle_add(self.out_back.grab_focus)
        # журнал — сразу к концу, чтобы видеть последние записи
        if to_end:
            GLib.idle_add(self._scroll_end)

    # предел ширины колонки в знаках — дальше растут поля, а не строка
    TEXT_MAX_CHARS = 96

    def _fit_text_width(self, widget, alloc):
        """Держать текст колонкой по центру, когда окно шире предела."""
        try:
            ctx = self.out_view.get_pango_context()
            metrics = ctx.get_metrics(ctx.get_font_description(), None)
            ch = metrics.get_approximate_char_width() / Pango.SCALE
            if ch <= 0:
                return
            want = int(ch * self.TEXT_MAX_CHARS)
            extra = alloc.width - want
            margin = max(12, extra // 2) if extra > 24 else 12
            if self.out_view.get_left_margin() != margin:
                self.out_view.set_left_margin(margin)
                self.out_view.set_right_margin(margin)
        except Exception:
            pass

    def _trim_text_menu(self, _view, menu):
        """Своё контекстное меню для журнала.

        Стандартное меню GTK предлагает «Вырезать», «Вставить», «Удалить»,
        «Вставить Emoji» — в журнале, открытом только на чтение, они ничего
        не делают, а «Сохранить содержимое в файл» дублирует наш пункт.
        Фильтровать чужие пункты по названию нельзя: имена зависят от языка
        системы. Поэтому убираем ВСЁ и собираем меню сами — одинаково на
        любой системе и на языке, выбранном в программе.
        """
        try:
            for item in list(menu.get_children()):
                menu.remove(item)
            def add(label, cb):
                mi = Gtk.MenuItem(label=label)
                mi.connect('activate', lambda _m: cb())
                menu.append(mi)

            add(self.t('ctx_copy'), self._ctx_copy)
            add(self.t('ctx_select_all'), self._ctx_select_all)
            # Пункт сохранения ровно один, и он меняется по обстановке:
            # выделен кусок — предлагаем сохранить его, нет выделения —
            # весь журнал. Показывать оба (один серым) нельзя: неактивный
            # пункт выглядит как поломка, хотя всё работает.
            menu.append(Gtk.SeparatorMenuItem())
            if self.out_buf.get_has_selection():
                add(self.t('ctx_save_sel'), self._ctx_save_selection)
            else:
                add(self.t('ctx_save'), self._save_buffer)
            menu.show_all()
        except Exception:
            pass

    def _ctx_save_selection(self):
        """Сохранить в файл только выделенный фрагмент журнала."""
        try:
            bounds = self.out_buf.get_selection_bounds()
            if not bounds:
                return
            s, e = bounds
            text = self.out_buf.get_text(s, e, True)
            if self._about_mode:
                text = self._wrap_manual(text)
            self._file_save(self._out_fname(fragment=True), text)
        except Exception:
            pass

    def _ctx_copy(self):
        """Скопировать выделенное (или всё, если ничего не выделено)."""
        try:
            cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            if self.out_buf.get_has_selection():
                self.out_buf.copy_clipboard(cb)
            else:
                s, e = self.out_buf.get_bounds()
                cb.set_text(self.out_buf.get_text(s, e, True), -1)
            self._show_toast(self.t('ctx_copied'))
        except Exception:
            pass

    def _ctx_select_all(self):
        try:
            s, e = self.out_buf.get_bounds()
            self.out_buf.select_range(s, e)
        except Exception:
            pass

    def _scroll_end(self):
        try:
            self.out_view.scroll_to_iter(
                self.out_buf.get_end_iter(), 0.0, False, 0, 0)
            adj = self.out_scroll.get_vadjustment()
            adj.set_value(adj.get_upper())
        except Exception:
            pass
        return False

    def _insert_colored(self, text):
        rx = re.compile(r'^(\S+\s+\d+\s+[\d:]+\s+\S+\s+)(\S+):\s(.*)$')
        rx_stat = re.compile(r'^(\s*[A-Z][A-Za-z ]+:\s)(.*)$')
        for line in text.splitlines():
            m = rx.match(line)
            if m:
                when, src, body = m.group(1), m.group(2), m.group(3)
                c = ('blue' if src.startswith('systemd') else
                     'purple' if src.startswith('kernel') else
                     'green' if src.startswith('env') else 'cyan')
                self._app(when, 'gray'); self._app(src, c)
                self._app(': ' + body + '\n', None)
                continue
            m = rx_stat.match(line)
            if m:
                fld, val = m.group(1), m.group(2)
                self._app(fld, 'gray')
                self._app(val + '\n',
                          'green' if val.lower().startswith('active (running)')
                          else None)
                continue
            self._app(line + '\n', None)

    def _app(self, text, tag):
        end = self.out_buf.get_end_iter()
        if tag:
            self.out_buf.insert_with_tags(end, text, self._tags[tag])
        else:
            self.out_buf.insert(end, text)

    def _out_fname(self, fragment=False):
        """Имя файла под то, что сейчас на экране.

        Поведение одно и то же, а содержимое разное: в «О программе» это
        руководство, в остальных случаях — журнал. Значит и расширение
        разное: руководство это текст, а не лог.
        """
        now = datetime.datetime.now()
        if self._about_mode:
            return 'autoswitch-manual-%s%s.txt' % (
                now.strftime('%Y%m%d'), '-fragment' if fragment else '')
        if fragment:
            return 'autoswitch-%s-%s-fragment.log' % (
                now.strftime('%Y%m%d'), now.strftime('%H%M'))
        return None   # длину посчитает вызывающий: она нужна в имени

    def _save_buffer(self):
        s, e = self.out_buf.get_bounds()
        content = self.out_buf.get_text(s, e, True)
        fname = self._out_fname()
        if fname is None:
            now = datetime.datetime.now()
            fname = 'autoswitch-%s-%s-%d.log' % (
                now.strftime('%Y%m%d'), now.strftime('%H%M'),
                len(content.splitlines()))
        if self._about_mode:
            content = self._wrap_manual(content)
        self._file_save(fname, content)

    @staticmethod
    def _wrap_manual(text):
        """Свёрстать руководство для файла.

        На экране строки переносит GTK по ширине окна, поэтому в тексте
        абзац — одна длинная строка. В файле так нельзя: обычный редактор
        без переноса по словам заставит мотать вбок.
        """
        import textwrap
        out = []
        for line in text.split('\n'):
            st = line.strip()
            if not st or st.startswith('\u2500') or line.startswith('    ') \
                    or st.isupper():
                out.append(line.rstrip())
            else:
                out.extend(textwrap.wrap(st, 90))
        return '\n'.join(out) + '\n'

    def _file_save(self, fname, content):
        dlg = Gtk.FileChooserDialog(title=self.t('log_save'), parent=self,
                                    action=Gtk.FileChooserAction.SAVE)
        dlg.add_buttons(self.t('cancel'), Gtk.ResponseType.CANCEL,
                        self.t('log_save'), Gtk.ResponseType.OK)
        dlg.set_current_name(fname)
        saved = None
        if dlg.run() == Gtk.ResponseType.OK:
            try:
                saved = dlg.get_filename()
                with open(saved, 'w') as f:
                    f.write(content)
            except Exception:
                saved = None
        dlg.destroy()
        return saved

    def refresh_status(self):
        active, enabled = svc_active(), svc_enabled()
        # «остановлен» — не авария, а обычное состояние: как и в
        # индикаторе, показываем его нейтральным, красный бережём
        # для настоящих ошибок
        st_c, st_t = ((GREEN, self.t('running')) if active
                      else (GRAY, self.t('stopped')))
        au_c, au_t = ((GREEN, self.t('on')) if enabled
                      else (YELLOW, self.t('off')))
        self.status_line.set_markup(
            '%s: <span foreground="%s" weight="bold">%s</span>'
            '      %s: <span foreground="%s" weight="bold">%s</span>'
            % (self.t('state'), st_c, st_t, self.t('autostart'),
               au_c, au_t))

    def _tick(self):
        self.refresh_status()
        return True

    # ── обработчики плиток ────────────────────────────────────────────
    def _svc(self, action, title, done=None):
        """Действие над службой.

        При успехе показываем всплывающее сообщение и остаёмся в меню:
        отдельный экран с одним словом «ok» и кнопкой «Назад» — лишний
        шаг. Экран вывода открываем только при ошибке, там есть что
        прочитать.
        """
        rc, out = svc_action(action)
        if rc != 0 and ('dismiss' in out.lower()
                        or 'not authorized' in out.lower()):
            return  # отмена пароля — просто ничего
        self.refresh_status()
        if rc == 0:
            self._show_toast(done or title, ms=2000)
            return
        self.show_output(out or 'ok', title)

    def on_start(self, _b):
        self._svc('start', self.t('m_start'), self.t('done_start'))

    def on_stop(self, _b):
