# Единственное, что исключено всегда (см. EXCLUDE_APPS в autoswitch.py) —
# окна самой программы: в них набирают слова для словаря и классы окон.
# В списке они показаны отмеченными, и галочку снять нельзя. Всё остальное,
# включая терминалы, — обычные записи конфига: хочет человек переключение
# в консоли, снимет галочку.
BUILTIN_EXCLUDES = {'autoswitch', 'asc-gui'}


def is_builtin_excluded(cls):
    """Исключено ли окно встроенным списком движка (без учёта конфига)."""
    c = (cls or '').strip().lower()
    if not c:
        return False
    return c in BUILTIN_EXCLUDES or c.rsplit('.', 1)[-1] in BUILTIN_EXCLUDES


def excl_read():
    raw = cfg_get('exclude_apps', '')
    return [t.strip().lower() for t in raw.split(',') if t.strip()]


def excl_write(tokens):
    """Записать список исключений и перезапустить службу.

    Движок читает exclude_apps только при старте, поэтому без перезапуска
    новое приложение остаётся в списке лишь на бумаге — легко решить, что
    исключения не работают.
    """
    joined = ','.join(dict.fromkeys([t for t in tokens if t]))
    ok = cfg_set('exclude_apps', joined)
    run(['pkexec', HELPER, 'service', 'restart'])
    poke_indicator()
    return ok


def scan_desktops():
    dirs = ['/usr/share/applications', '/usr/local/share/applications',
            os.path.expanduser('~/.local/share/applications')]
    out = {}
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for fn in os.listdir(d):
            if not fn.endswith('.desktop'):
                continue
            path = os.path.join(d, fn)
            name = cls = ''
            nodisplay = False
            try:
                with open(path, errors='ignore') as f:
                    for line in f:
                        if line.startswith('NoDisplay=true'):
                            nodisplay = True
                        elif line.startswith('Name=') and not name:
                            name = line.split('=', 1)[1].strip()
                        elif line.startswith('StartupWMClass='):
                            cls = line.split('=', 1)[1].strip()
            except Exception:
                continue
            if nodisplay:
                continue
            if not cls:
                cls = fn[:-8]
            cls = cls.lower()
            if not name:
                name = cls
            out[cls] = name
    return sorted(out.items(), key=lambda kv: kv[1].lower())


def current_window_class():
    """Класс активного окна: KWin-файл → GNOME-мост → X11 xprop."""
    uid = os.getuid()
    ff = '/run/user/%d/autoswitch-focus' % uid
    try:
        if os.path.isfile(ff):
            with open(ff) as f:
                cls = f.read().strip().lower()
            if cls:
                return cls
    except Exception:
        pass
    # GNOME мост
    r = run(['gdbus', 'call', '--session', '-d', 'org.gnome.Shell',
             '-o', '/org/gnome/Shell/Extensions/AutoswitchFocus',
             '-m', 'org.gnome.Shell.Extensions.AutoswitchFocus.GetFocusedClass'])
    if r[0] == 0:
        m = re.search(r"'([^']*)'", r[1])
        if m and m.group(1):
            return m.group(1).lower()
    # X11
    if run(['sh', '-c', 'command -v xprop'])[0] == 0:
        aw = run(['xprop', '-root', '_NET_ACTIVE_WINDOW'])[1]
        m = re.search(r'#\s*(0x[0-9a-fA-F]+)', aw)
        if m and m.group(1) != '0x0':
            wc = run(['xprop', '-id', m.group(1), 'WM_CLASS'])[1]
            m2 = re.search(r'"([^"]*)"[^"]*$', wc)
            if m2:
                return m2.group(1).lower()
    return ''


# ── Диагностический отчёт (порт save_log_file из asc) ────────────────
def diag_report(t):
    """Диагностический отчёт. t — переводчик из окна (self.t), чтобы
    отчёт был на языке интерфейса, а не всегда по-русски."""
    home = os.path.expanduser('~')
    L = []
    L.append(t('rep_title'))
    L.append(t('rep_taken') + datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))
    L.append('')
    L.append(t('rep_system'))
    L.append(run(['uname', '-a'])[1].strip())
    try:
        with open('/etc/os-release') as f:
            for line in f:
                if line.startswith('PRETTY_NAME='):
                    L.append(line.split('=', 1)[1].strip().strip('"'))
    except Exception:
        pass
    L.append(t('rep_session')
             % (os.environ.get('XDG_SESSION_TYPE', '?'),
                os.environ.get('XDG_CURRENT_DESKTOP', '?')))
    L.append(t('rep_locale') + os.environ.get('LANG', '?'))
    L.append('')
    L.append(t('rep_install'))
    for f in ('/usr/local/bin/asc', '/usr/local/bin/asc-gui',
              '/usr/local/lib/autoswitch/autoswitch.py',
              '/usr/local/bin/autoswitch-indicator'):
        if os.path.exists(f):
            mt = datetime.datetime.fromtimestamp(os.path.getmtime(f))
            L.append(mt.strftime('%Y-%m-%d %H:%M') + '  ' + f)
    L.append('')
    L.append(t('rep_indicator'))
    desk = (os.environ.get('XDG_CURRENT_DESKTOP', '') or '').lower()
    gnome_ext = os.path.isdir(home + '/.local/share/gnome-shell/extensions/'
                              'autoswitch@shah-man.github.io')
    kde_applet = os.path.isdir(home + '/.local/share/plasma/plasmoids/'
                               'org.shah-man.autoswitch')
    if 'gnome' in desk:
        L.append(t('rep_ext_gnome')
                 % (t('rep_installed') if gnome_ext else t('rep_not_installed')))
    elif 'kde' in desk or 'plasma' in desk:
        L.append(t('rep_applet_kde')
                 % (t('rep_installed') if kde_applet else t('rep_not_installed')))
    else:
        if os.access('/usr/local/bin/autoswitch-indicator', os.X_OK):
            running = run(['pgrep', '-f', 'autoswitch-indicator'])[0] == 0
            L.append(t('rep_tray_yes'))
            L.append(t('rep_tray_run') if running
                     else t('rep_tray_stop'))
        else:
            L.append(t('rep_tray_no'))
    L.append('')
    L.append(t('rep_deps'))
    for c in ('dialog', 'less', 'awk'):
        path = run(['sh', '-c', 'command -v %s' % c])[1].strip()
        L.append('%-24s %s' % (c, path or t('rep_absent')))
    for m in ('evdev', 'Xlib'):
        ok = run(['python3', '-c', 'import %s' % m])[0] == 0
        L.append('%-24s %s' % ('python3-' + m, t('rep_yes') if ok else t('rep_no')))
    for g, ver in (('Gtk', '3.0'), ('Vte', '2.91'),
                   ('AyatanaAppIndicator3', '0.1')):
        ok = run(['python3', '-c',
                  "import gi; gi.require_version('%s','%s')" % (g, ver)])[0] == 0
        L.append('%-24s %s' % (g, t('rep_yes') if ok else t('rep_no')))
    for name, p in ((t('rep_dict') % 'ru', '/usr/share/hunspell/ru_RU.dic'),
                    (t('rep_dict') % 'en', '/usr/share/hunspell/en_US.dic')):
        L.append('%-24s %s' % (name, p if os.path.exists(p) else t('rep_absent')))
    L.append('')
    L.append(t('rep_layouts'))
    xkb = run(['setxkbmap', '-query'])
    L.append(xkb[1].strip() if xkb[0] == 0 else t('rep_xkb_na'))
    gs = run(['gsettings', 'get', 'org.gnome.desktop.input-sources', 'sources'])
    if gs[0] == 0:
        L.append('GNOME: ' + gs[1].strip())
    L.append('')
    L.append(t('rep_keyboards'))
    try:
        with open('/proc/bus/input/devices') as f:
            for b in f.read().split('\n\n'):
                if 'eyboard' in b:
                    for line in b.splitlines():
                        if line.startswith(('N:', 'H:')):
                            L.append(line)
    except Exception:
        pass
    L.append('')
    L.append(t('rep_settings'))
    try:
        with open(CONFIG) as f:
            for line in f:
                s = line.strip()
                if s and not s.startswith('#'):
                    L.append(s)
    except Exception:
        L.append(t('rep_nofile') + CONFIG)
    L.append('')
    L.append(t('rep_excl'))
    ex = excl_read()
    # переменная цикла НЕ должна называться t: это имя занято переводчиком,
    # и после цикла вызов t('...') падал с «str object is not callable»
    for item in ex[:50]:
        L.append('  ' + item)
    L.append(t('rep_total') % len(ex))
    L.append('')
    try:
        with open(LEARNED) as f:
            nw = sum(1 for ln in f
                     if ln.strip() and not ln.strip().startswith('#'))
    except Exception:
        nw = 0
    L.append(t('rep_ownwords') % nw)
    L.append('')
    L.append(t('rep_svc'))
    L.append(svc_status_text().strip())
    L.append('')
    L.append(t('rep_errors'))
    warn = run(['grep', '-iE', 'error|failed|ошибк|не удалось|bridge FAILED',
                LOGFILE])[1].strip()
    warn = '\n'.join(warn.splitlines()[-50:])
    L.append(warn if warn.strip() else t('rep_noerrors'))
    L.append('')
    L.append(t('rep_log'))
    L.append(svc_log_all().strip())
    return '\n'.join(L) + '\n'




