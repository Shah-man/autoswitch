    def _excl_filter(self, entry):
        q = entry.get_text().lower().strip()
        for row in self.ex_listbox.get_children():
            row.set_visible((q in row._chk._name) if q else True)

    # ── захват активного окна ─────────────────────────────────────────
    def _excl_add_current(self):
        """Ловим чужое окно: даём время кликнуть по нему, как sleep 3 в asc."""
        if getattr(self, '_ex_catch_id', None):
            return
        self._ex_caught = ''
        self._ex_ticks = 10          # 10 x 500мс = 5 секунд
        self.ex_addcur.set_sensitive(False)
        self._excl_catch_label()
        self._ex_catch_id = GLib.timeout_add(500, self._excl_catch_tick)

    def _excl_catch_label(self):
        secs = (self._ex_ticks + 1) // 2
        self.ex_addcur_lbl.set_markup(
            '<span foreground="%s" weight="bold">%s</span>'
            % (YELLOW, self.t('ex_cur_count') % secs))

    def _excl_catch_tick(self):
        # опрашиваем каждые 500мс и запоминаем последнее ЧУЖОЕ окно, поэтому
        # можно вернуться в Autoswitch раньше — класс уже пойман
        try:
            cls = current_window_class()
        except Exception:
            cls = ''
        if cls and cls not in SELF_CLASSES:
            self._ex_caught = cls
        self._ex_ticks -= 1
        if self._ex_ticks > 0:
            self._excl_catch_label()
            return True

        self._ex_catch_id = None
        self.ex_addcur.set_sensitive(True)
        self.ex_addcur_lbl.set_markup(
            '<span foreground="%s">%s</span>' % (CYAN, self.t('ex_current')))

        cls = self._ex_caught
        if not cls:
            self._show_toast(self.t('ex_cur_self'), ms=2600)
            return False
        manual = cls not in self.ex_checks
        self._excl_toggle(cls, True, name=cls, manual=manual)
        if not manual:
            self.ex_search.set_text('')
            GLib.idle_add(self._excl_scroll_to, self.ex_checks[cls].get_parent())
        self._show_toast('%s: %s' % (self.t('ex_cur_got'), cls), ms=2600)
        return False

    def _excl_scroll_to(self, row):
        try:
            adj = self.ex_scroll.get_vadjustment()
            y = row.get_allocation().y
            page = adj.get_page_size()
            target = max(0, min(y - page / 2.0, adj.get_upper() - page))
            adj.set_value(target)
        except Exception:
            pass
        return False

    def _excl_cancel_catch(self):
        if getattr(self, '_ex_catch_id', None):
            GLib.source_remove(self._ex_catch_id)
            self._ex_catch_id = None
        if getattr(self, 'ex_addcur', None):
            self.ex_addcur.set_sensitive(True)
            self.ex_addcur_lbl.set_markup(
                '<span foreground="%s">%s</span>' % (CYAN, self.t('ex_current')))

    # ── адаптив: на узком окне колонки показываются по очереди ────────
    def _excl_adapt(self, width):
        self._apply_compact(width < COMPACT_W)
        if not getattr(self, 'ex_paned', None):
            return
        narrow = width < NARROW_W
        if narrow == self._ex_narrow:
            return
        self._ex_narrow = narrow
        if narrow:
            self.ex_swap.show()
            self._excl_show_pane(self._ex_pane_shown)
        else:
            self.ex_swap.hide()
            self.ex_left.show()
            self.ex_right.show()
            GLib.idle_add(self._excl_pane_default)

    def _excl_pane_default(self):
        try:
            w = self.ex_paned.get_allocated_width()
            if w > 1:
                pos = getattr(self, '_ex_pane_pos', None)
                if pos and 60 < pos < w - 60:
                    self.ex_paned.set_position(pos)
                else:
                    self.ex_paned.set_position(int(w * 0.58))
        except Exception:
            pass
        return False

    def _excl_pane_moved(self, paned, _p):
        if not self._ex_narrow:
            self._ex_pane_pos = paned.get_position()

    def _excl_show_pane(self, which):
        self._ex_pane_shown = which
        if getattr(self, 'ex_swap_lbl', None):
            arrow = '\u25b6' if which == 'left' else '\u25c0'
            self.ex_swap_lbl.set_markup(
                '<span foreground="%s" weight="bold" size="13000">%s</span>'
                % (YELLOW, arrow))
            self.ex_swap.set_tooltip_text(
                self.t('ex_added' if which == 'left' else 'ex_all'))
        if which == 'left':
            self.ex_left.show()
            self.ex_right.hide()
        else:
            self.ex_left.hide()
            self.ex_right.show()

    def _excl_swap_pane(self):
        self._excl_show_pane('right' if self._ex_pane_shown == 'left' else 'left')

    # ── загрузка и сохранение ─────────────────────────────────────────
    def _show_exclusions(self):
        self._excl_cancel_catch()
        for row in self.ex_listbox.get_children():
            self.ex_listbox.remove(row)
        for row in self.ex_added_box.get_children():
            self.ex_added_box.remove(row)
        self._ex_steam_row = None
        self.ex_checks = {}
        self.ex_added = {}
        self.ex_names = {}

        current = [c for c in excl_read() if c]
        cur_set = set(current)
        self.ex_steam.set_active(any(t in cur_set for t in STEAM_TOKENS))

        # левая колонка — все приложения системы
        known = set()
        for cls, nm in scan_desktops():
            self._ex_sync = True
            self._excl_add_row(cls, nm, cls in cur_set)
            self._ex_sync = False
            known.add(cls)

        # правая колонка — всё, что реально лежит в конфиге, включая записи
        # без своего .desktop (пойманные окна и правки руками)
        for cls in current:
            if cls in STEAM_TOKENS:
                continue
            self._excl_toggle(cls, True, name=self.ex_names.get(cls, cls),
                              manual=cls not in known)

        self.ex_search.set_text('')
        self._nav_to('exclusions')
        self.ex_listbox.show_all()
        self.ex_added_box.show_all()
        self._excl_refresh_count()
        self._ex_narrow = None
        self._excl_adapt(self.get_allocated_width())
        # рамка на первом пункте экрана, дальше стрелками вниз по всем
        GLib.idle_add(self.ex_steam.grab_focus)

    def _excl_save(self):
        toks = list(self.ex_added.keys())
        if self.ex_steam.get_active():
            toks += STEAM_TOKENS
        # Ничего не изменилось — не пишем конфиг и не дёргаем службу.
        new_set = set(t for t in toks if t)
        if new_set == set(excl_read()):
            self._nav_back()
            self._show_toast(self.t('cfg_unchanged'))
            return
        try:
            excl_write(toks)      # внутри: запись, перезапуск, сигнал индикатору
        except Exception:
            self._nav_back()
            self._show_toast(self.t('log_clear_fail'))
            return
        self._nav_back()
        self._show_toast(self.t('ex_saved'))
        self.refresh_status()

