# Раскладка us/ru для перевода learned-правил в человекочитаемый вид и
# обратно. Ключ в learned.txt — US-форма (латинские клавиши), но человеку
# показываем слово так, как оно выглядит на экране в целевой раскладке:
# правило `bltt ru` → «идее», `hello us` → «hello».
_KB_US = "qwertyuiop[]asdfghjkl;'zxcvbnm,./`"
_KB_RU = "йцукенгшщзхъфывапролджэячсмитьбю.ё"
_US2RU = {u: r for u, r in zip(_KB_US, _KB_RU)}
_RU2US = {r: u for u, r in zip(_KB_US, _KB_RU)}


def us_to_display(us_form, lang):
    """US-форма + язык → как слово выглядит на экране (для показа юзеру)."""
    if lang == 'ru':
        return ''.join(_US2RU.get(c, c) for c in us_form.lower())
    return us_form.lower()


def display_to_us(word):
    """Слово в любой раскладке → US-форма (для сохранения в learned)."""
    return ''.join(_RU2US.get(c, c) for c in word.lower())


