def run(cmd, input_text=None):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True,
                           input=input_text)
        return p.returncode, (p.stdout or '') + (p.stderr or '')
    except Exception as e:
        return 1, str(e)


