# ── рабочая область там, где панель не резервирует место ─────────────
# LXQt (Lubuntu) не выставляет _NET_WORKAREA по панели: она равна всему
# экрану, и окно разворачивается под панель. Считаем область сами по
# окнам-докам. Размеры экрана и панели нигде не зашиты — берём фактические,
# поэтому работает на любом разрешении и при панели с любой стороны.
def dock_rects():
    """[(x, y, w, h)] окон-панелей. Пустой список, если X11 недоступен."""
    rects = []
    if os.environ.get('WAYLAND_DISPLAY') and not os.environ.get('DISPLAY'):
        return rects
    try:
        lib = ctypes.CDLL('libX11.so.6')
    except OSError:
        return rects
    try:
        lib.XOpenDisplay.restype = ctypes.c_void_p
        lib.XOpenDisplay.argtypes = [ctypes.c_char_p]
        lib.XDefaultRootWindow.restype = ctypes.c_ulong
        lib.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        lib.XInternAtom.restype = ctypes.c_ulong
        lib.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p,
                                    ctypes.c_int]
        lib.XGetWindowProperty.restype = ctypes.c_int
        lib.XGetWindowProperty.argtypes = [
            ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_long,
            ctypes.c_long, ctypes.c_int, ctypes.c_ulong,
            ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_ulong),
            ctypes.POINTER(ctypes.POINTER(ctypes.c_ubyte))]
        lib.XGetGeometry.restype = ctypes.c_int
        lib.XGetGeometry.argtypes = [
            ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong),
            ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_uint), ctypes.POINTER(ctypes.c_uint),
            ctypes.POINTER(ctypes.c_uint), ctypes.POINTER(ctypes.c_uint)]
        lib.XTranslateCoordinates.restype = ctypes.c_int
        lib.XTranslateCoordinates.argtypes = [
            ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_int,
            ctypes.c_int, ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_ulong)]
        lib.XFree.argtypes = [ctypes.c_void_p]
        lib.XCloseDisplay.argtypes = [ctypes.c_void_p]
    except Exception:
        return rects

    # указатель держим как c_void_p: голый int ctypes ужимает до 32 бит,
    # libX11 разыменовывает огрызок и процесс падает
    dpy = ctypes.c_void_p(lib.XOpenDisplay(None))
    if not dpy.value:
        return rects
    try:
        root = lib.XDefaultRootWindow(dpy)
        a_list = lib.XInternAtom(dpy, b'_NET_CLIENT_LIST', 1)
        a_type = lib.XInternAtom(dpy, b'_NET_WM_WINDOW_TYPE', 1)
        a_dock = lib.XInternAtom(dpy, b'_NET_WM_WINDOW_TYPE_DOCK', 1)
        if not a_list or not a_type or not a_dock:
            return rects

        def prop(win, atom, want_type):
            at = ctypes.c_ulong()
            fmt = ctypes.c_int()
            n = ctypes.c_ulong()
            rest = ctypes.c_ulong()
            data = ctypes.POINTER(ctypes.c_ubyte)()
            rc = lib.XGetWindowProperty(
                dpy, win, atom, 0, 4096, 0, want_type,
                ctypes.byref(at), ctypes.byref(fmt), ctypes.byref(n),
                ctypes.byref(rest), ctypes.byref(data))
            if rc != 0 or not data:
                return []
            try:
                if fmt.value != 32:
                    return []
                arr = ctypes.cast(data, ctypes.POINTER(ctypes.c_ulong))
                return [arr[i] for i in range(n.value)]
            finally:
                lib.XFree(data)

        for win in prop(root, a_list, 33):          # 33 = XA_WINDOW
            if a_dock not in prop(win, a_type, 4):  # 4 = XA_ATOM
                continue
            rr = ctypes.c_ulong()
            x = ctypes.c_int()
            y = ctypes.c_int()
            w = ctypes.c_uint()
            h = ctypes.c_uint()
            b = ctypes.c_uint()
            d = ctypes.c_uint()
            if lib.XGetGeometry(dpy, win, ctypes.byref(rr), ctypes.byref(x),
                                ctypes.byref(y), ctypes.byref(w),
                                ctypes.byref(h), ctypes.byref(b),
                                ctypes.byref(d)) == 0:
                continue
            ax = ctypes.c_int()
            ay = ctypes.c_int()
            child = ctypes.c_ulong()
            if lib.XTranslateCoordinates(dpy, win, root, 0, 0,
                                         ctypes.byref(ax), ctypes.byref(ay),
                                         ctypes.byref(child)) == 0:
                ax, ay = x, y
            if w.value > 0 and h.value > 0:
                rects.append((ax.value, ay.value, w.value, h.value))
    except Exception:
        pass
    finally:
        try:
            lib.XCloseDisplay(dpy)
        except Exception:
            pass
    return rects


