        dlg.destroy()
        return resp == Gtk.ResponseType.OK

    def _clear_log(self):
        """Стереть журнал (после подтверждения).

        journald не умеет удалять записи выборочно по одной службе, поэтому
        чистится весь системный журнал — об этом честно предупреждаем.
        Нужно для приватности: при включённом debug_log в журнал попадают
        набранные слова.
        """
        if not self._confirm(self.t('log_clear_t'), self.t('log_clear_q')):
            return
        rc, _out = run(['pkexec', HELPER, 'clear-log'])
        if rc == 0:
            self.show_output(svc_log_today(), self.t('m_log'), colorize=True,
                             to_end=True, with_clear=True)
            self._show_toast(self.t('log_cleared'))
        else:
            self._show_toast(self.t('log_clear_fail'))

