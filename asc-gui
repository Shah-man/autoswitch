# Файл-маячок: способ сказать GNOME-расширению, что состояние службы
# изменилось. Расширение — отдельная программа в составе оболочки, напрямую
# мы к нему не достучимся, зато оно умеет следить за файлом. Трогаем маячок,
# расширение видит изменение и коротко показывает перезапуск в панели.
BEACON = os.path.join(GLib.get_user_runtime_dir() or '/tmp',
                      'autoswitch.beacon')


def poke_indicator():
    """Сказать индикаторам обновиться прямо сейчас.

    Служба перезапускается мгновенно, а индикатор опрашивает состояние раз
    в несколько секунд — без этого сигнала он показал бы перезапуск сильно
    позже или не заметил бы вовсе. GTK-индикатору стучимся в unix-сокет,
    GNOME-расширению — через файл-маячок. Кого нет, тот просто не услышит.
    """
    try:
        # маячок для GNOME-расширения: обновляем время файла
        with open(BEACON, 'w') as f:
            f.write(datetime.datetime.now().isoformat())
    except Exception:
        pass
    try:
        p = os.path.join(GLib.get_user_runtime_dir() or '/tmp',
                         'autoswitch-indicator.sock')
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(0.5)
        c.connect(p)
        c.sendall(b'refresh')
        c.close()
    except Exception:
        pass


