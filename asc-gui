        GLib.idle_add(self._focus_tile, 0)

    # ── язык ──────────────────────────────────────────────────────────
    def t(self, key):
        return TR.get(self.lang, TR['ru']).get(key, TR['ru'].get(key, key))

    # ── запоминание размера окна ──────────────────────────────────────
    def _order_file(self):
        d = os.path.expanduser('~/.config/autoswitch')
        try:
            os.makedirs(d, exist_ok=True)
        except Exception:
            pass
        return os.path.join(d, 'gui-tiles')

    def _load_order(self, name):
        try:
            with open(self._order_file()) as f:
                for line in f:
                    k, _, v = line.strip().partition('=')
                    if k == name and v:
                        return v.split(',')
        except Exception:
            pass
        return []

    def _save_order(self, name, keys):
        data = {}
        try:
            with open(self._order_file()) as f:
                for line in f:
                    k, _, v = line.strip().partition('=')
                    if k:
                        data[k] = v
        except Exception:
            pass
        data[name] = ','.join(keys)
        try:
            with open(self._order_file(), 'w') as f:
                for k, v in data.items():
                    f.write('%s=%s\n' % (k, v))
        except Exception:
            pass

    def _apply_order(self, name, items):
        """items: список (ключ, ...). Порядок пользователя, новые — в конец."""
        saved = self._load_order(name)
        if not saved:
            return items
        by_key = {it[0]: it for it in items}
        out = [by_key.pop(k) for k in saved if k in by_key]
        out.extend(it for it in items if it[0] in by_key)
        return out

    def attach_ipc(self, srv):
        """Слушаем сокет: вторая копия просит поднять это окно."""
        self._ipc = srv
        GLib.io_add_watch(srv.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN,
                          self._on_ipc)

    def _on_ipc(self, *_a):
        try:
            conn, _addr = self._ipc.accept()
            conn.recv(64)
            conn.close()
        except Exception:
            pass
        try:
            self.deiconify()
            self.present_with_time(Gdk.CURRENT_TIME)
        except Exception:
            pass
        return True

    def _size_file(self):
        d = os.path.expanduser('~/.config/autoswitch')
        try:
            os.makedirs(d, exist_ok=True)
        except Exception:
            pass
        return os.path.join(d, 'gui-size')

    def _real_workarea(self):
        """Рабочая область текущего монитора с учётом панелей.

        Сначала спрашиваем систему. Если она отдаёт весь экран (LXQt так и
        делает — панель место не резервирует), вычитаем панели сами.
        Ничего не зашито: размеры берутся у монитора и у самих панелей,
        поэтому работает на любом экране и при панели с любой стороны.
        """
        try:
            disp = Gdk.Display.get_default()
            mon = None
            try:
                gw = self.get_window()
                if gw is not None:
                    mon = disp.get_monitor_at_window(gw)
            except Exception:
                mon = None
            if mon is None:
                mon = disp.get_primary_monitor() or disp.get_monitor(0)
            geo = mon.get_geometry()
            wa = mon.get_workarea()
        except Exception:
            return None

        x, y = wa.x, wa.y
        w, h = wa.width, wa.height
        if w <= 0 or h <= 0:
            return None
        # система уже учла панели — доверяем ей
        if w < geo.width or h < geo.height:
            return (x, y, w, h)

        top = bottom = left = right = 0
        for (px, py, pw, ph) in dock_rects():
            # панель считаем только если она на этом мониторе
            if px + pw <= geo.x or px >= geo.x + geo.width:
                continue
            if py + ph <= geo.y or py >= geo.y + geo.height:
                continue
            if pw >= ph:                       # горизонтальная панель
                if py <= geo.y + geo.height / 2:
                    top = max(top, py + ph - geo.y)
                else:
                    bottom = max(bottom, geo.y + geo.height - py)
            else:                              # вертикальная
                if px <= geo.x + geo.width / 2:
                    left = max(left, px + pw - geo.x)
                else:
                    right = max(right, geo.x + geo.width - px)
        if not (top or bottom or left or right):
            return (x, y, w, h)
        return (geo.x + left, geo.y + top,
                geo.width - left - right, geo.height - top - bottom)

    def _restore_window_state(self):
        """Вернуть окно в развёрнутое состояние, если так его и закрыли."""
        if getattr(self, '_was_maximized', False):
            try:
                self.maximize()
            except Exception:
                pass
        return False

    def _fit_workarea(self, w, h):
        area = self._real_workarea()
        if area:
            w = min(w, area[2])
            h = min(h, area[3])
        return max(w, MIN_W), max(h, MIN_H)

    def _load_size(self):
        """Размер окна и было ли оно развёрнуто.

        В файле два числа, как и раньше, плюс необязательное третье —
        признак развёрнутого окна. Файл от прежней версии читается без
        изменений: третьего значения нет, значит окно обычное.
        """
        self._was_maximized = False
        try:
            with open(self._size_file()) as f:
                parts = f.read().split()
            w, h = int(parts[0]), int(parts[1])
            if len(parts) > 2:
                self._was_maximized = parts[2] == '1'
            return self._fit_workarea(w, h)
        except Exception:
            return MIN_W, MIN_H

    def _on_resize(self, _w, _e):
        try:
            self._excl_adapt(self.get_allocated_width())
        except Exception:
            pass
        if self._save_id:
            GLib.source_remove(self._save_id)
        self._save_id = GLib.timeout_add(500, self._save_size)
        return False

    def _save_size(self):
        self._save_id = None
        try:
            maxi = self.is_maximized()
        except Exception:
            maxi = False
        try:
            if maxi:
                # у развёрнутого окна размер равен экрану; запиши его как
                # обычный — и «свернуть в окно» некуда будет возвращаться,
                # поэтому оставляем прежний размер, меняем только признак
                w, h = getattr(self, '_normal_size', (0, 0))
                if not w or not h:
                    w, h = self.get_size()
            else:
                w, h = self.get_size()
                self._normal_size = (w, h)
            with open(self._size_file(), 'w') as f:
                f.write('%d %d %d' % (w, h, 1 if maxi else 0))
        except Exception:
            pass
        return False

    # ── сборка всех экранов ───────────────────────────────────────────
    def _build_all(self):
        for ch in self.stack.get_children():
            self.stack.remove(ch)
        self.tiles = []
        self.stack.add_named(self._build_main(), 'main')
        self.stack.add_named(self._build_output(), 'output')
        self.stack.add_named(self._build_settings(), 'settings')
        self.stack.add_named(self._build_edit(), 'edit')
        self.stack.add_named(self._build_exclusions(), 'exclusions')
        self.stack.add_named(self._build_techdict(), 'techdict')
        for _sc in self.stack.get_children():
            self._soften(_sc)
        self.stack.show_all()
        self.stack.set_visible_child_name('main')
        self.bottom_bar.hide()
        self.about_bar.hide()
        self.refresh_status()

    def _relang(self):
        """Пересобрать всё после смены языка, остаться на настройках."""
        self._build_all()
        self.stack.set_visible_child_name('settings')
        return False

    # ── шапка-строка (общая для экранов) ──────────────────────────────
    def _topbar(self, title_text, on_back=None):
        if on_back is None:
            on_back = self._nav_back
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        bar.get_style_context().add_class('header')
        bar.set_border_width(14)
        lbl = Gtk.Label()
        lbl.set_markup('<span foreground="%s" weight="bold">%s</span>'
                       % (CYAN, title_text))
        lbl.set_halign(Gtk.Align.START)
        lbl.set_ellipsize(Pango.EllipsizeMode.END)
        # Заголовок НЕ растягиваем: иначе он занимает всю ширину и всё, что
        # упаковано после него, уезжает к правому краю — к кнопке «Назад».
        # Свободное место забирает распорка ниже, поэтому кнопки экрана
        # можно ставить сразу за заголовком (см. _build_output).
        bar.pack_start(lbl, False, False, 0)
        self._bar_spacer = Gtk.Box()
        bar.pack_start(self._bar_spacer, True, True, 0)
        back = Gtk.Button()
        back.get_style_context().add_class('mini')
        blbl = self._lbl(self.t('back') + '  \u23ce', CYAN, bold=True)
        back.add(blbl)
        back.set_tooltip_text(self.t('back'))
        self._reg_compact(blbl, self.t('back') + '  \u23ce', '\u23ce', CYAN)
        self._hoverable(back)
        back.connect('clicked', lambda _b: on_back())
        bar.pack_end(back, False, False, 0)
        self._last_back_btn = back
        # запоминаем кнопку в самой строке: экраны ставят на неё фокус,
        # чтобы рамка выделения не оказывалась на опасных действиях
        bar.back_button = back
        return bar, lbl

    # ── главный экран ─────────────────────────────────────────────────
    def _tiles_def(self):
        return [
            (self.t('m_start'),    '\u25b6', GREEN,  'on_start'),
            # Остановка — обычное действие пользователя, а не авария.
            # Красный оставлен ошибке: в индикаторе остановленная служба
            # тоже светлая, а красный горит только при сбое.
            (self.t('m_stop'),     '\u25a0', FG,     'on_stop'),
            (self.t('m_restart'),  '\u21bb', YELLOW, 'on_restart'),
            (self.t('m_autostart'),'\u23fb', BLUE,   'on_toggle_auto'),
            (self.t('m_status'),   '\u24d8', CYAN,   'on_status'),
            (self.t('m_log'),      '\u2630', PURPLE, 'on_log'),
            (self.t('about'),      '\u2726', GRAY,   'on_about'),
            (self.t('m_settings'), '\u2699', FG,     'on_settings'),
        ]

    def _build_main(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.get_style_context().add_class('header')
        header.set_border_width(18)
        title = Gtk.Label()
        title.set_markup('<span size="21000" weight="bold" foreground="%s" '
                         'letter_spacing="512">Autoswitch</span>' % CYAN)
        title.set_halign(Gtk.Align.START)
        header.pack_start(title, False, False, 0)
        self.status_line = Gtk.Label()
        self.status_line.set_halign(Gtk.Align.START)
        header.pack_start(self.status_line, False, False, 0)
        root.pack_start(header, False, False, 0)
        grid = Gtk.Grid()
        grid.set_row_spacing(12); grid.set_column_spacing(12)
        grid.set_border_width(18)
        grid.set_row_homogeneous(True); grid.set_column_homogeneous(True)
        grid.set_vexpand(True); grid.set_hexpand(True)
        defs = self._apply_order('main', [(h, l, g, c) for l, g, c, h
                                          in self._tiles_def()])
        for i, (handler, label, glyph, color) in enumerate(defs):
            tile = self._make_tile(label, glyph, color, getattr(self, handler))
            self._hoverable(tile)
            self._make_draggable(tile, handler, 'main')
            self.tiles.append(tile)
            grid.attach(tile, i % 2, i // 2, 1, 1)
        self._grids['main'] = (grid, self.tiles,
                               [h for _l, _g, _c, h in self._tiles_def()])
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(grid)
        root.pack_start(scroll, True, True, 0)
        return root

    def _make_tile(self, label, glyph, color, handler):
        btn = Gtk.Button()
        btn.get_style_context().add_class('tile')
        btn.set_can_focus(True)
        btn.set_size_request(-1, 70)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_valign(Gtk.Align.CENTER); box.set_halign(Gtk.Align.CENTER)
        gl = Gtk.Label()
        gl.set_markup('<span size="26000" foreground="%s">%s</span>'
                      % (color, glyph))
        lb = Gtk.Label()
        lb.set_markup('<span size="12000" weight="bold" foreground="%s">%s'
                      '</span>' % (color, label))
        box.pack_start(gl, False, False, 0)
        box.pack_start(lb, False, False, 0)
        btn.add(box)
        btn.connect('clicked', handler)
        return btn

    # ── экран вывода (журнал/статус) ──────────────────────────────────
    def _build_output(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        bar, self.out_title = self._topbar('')
        self.out_back = self._last_back_btn
        # Кнопка очистки журнала — только на экране журнала (на статусе и
        # отчёте она не нужна, поэтому по умолчанию скрыта). Приватность:
        # при включённом debug_log в журнал попадают набранные слова.
        self.btn_clearlog = Gtk.Button()
        self.btn_clearlog.get_style_context().add_class('mini')
        self.lbl_clearlog = self._lbl(self.t('log_clear'), PURPLE, bold=True)
        self.btn_clearlog.add(self.lbl_clearlog)
        # Подсказку оставляем обычным текстом: пузырёк рисует системная
        # тема, и заданный нами цвет на светлых темах читался бы плохо.
        self.btn_clearlog.set_tooltip_text(self.t('log_clear_tip'))
        # рамка перескакивает на кнопку при наведении мыши, как у остальных
        self._hoverable(self.btn_clearlog)
        self.btn_clearlog.connect('clicked', lambda _b: self._clear_log())
        # Ставим кнопку СЛЕВА, сразу за заголовком, а не рядом с «Назад»:
        # иначе легко промахнуться и стереть журнал вместо выхода с экрана.
        # reorder ставит её перед распоркой, которая забирает остальное место.
        bar.pack_start(self.btn_clearlog, False, False, 0)
        bar.reorder_child(self.btn_clearlog, 1)
        # Фокус на кнопку переходит при наведении мыши (как у остальных),
        # но ПРИ ОТКРЫТИИ журнала он ставится на «Назад» — иначе случайный
        # Enter сразу стёр бы журнал (см. on_log).
        # содержимое кнопки показываем сразу, скрываем/показываем только саму
        # кнопку — иначе метка внутри остаётся невидимой и виден пустой блок
        self.lbl_clearlog.show()
        self.btn_clearlog.set_no_show_all(True)
        root.pack_start(bar, False, False, 0)
        self.out_scroll = Gtk.ScrolledWindow()
        self.out_scroll.set_policy(Gtk.PolicyType.AUTOMATIC,
                                   Gtk.PolicyType.AUTOMATIC)
        self.out_view = Gtk.TextView()
        self.out_view.set_editable(False)
        self.out_view.set_cursor_visible(False)
        self.out_view.set_monospace(True)
        self.out_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.out_view.get_style_context().add_class('output')
        self.out_view.set_left_margin(12); self.out_view.set_right_margin(12)
        self.out_view.set_top_margin(10)
        # Журнал только для чтения, а GTK всё равно предлагает «Вырезать»,
        # «Вставить», «Удалить», «Вставить Emoji» — они здесь ничего не
        # делают и только сбивают с толку. Оставляем осмысленное:
        # копировать, выделить всё, сохранить в файл.
        self.out_view.connect('populate-popup', self._trim_text_menu)
        self.out_buf = self.out_view.get_buffer()
        self._tags = {
            'gray':   self.out_buf.create_tag('gray',   foreground=GRAY),
            'green':  self.out_buf.create_tag('green',  foreground=GREEN),
            'blue':   self.out_buf.create_tag('blue',   foreground=BLUE),
            'purple': self.out_buf.create_tag('purple', foreground=PURPLE),
            'cyan':   self.out_buf.create_tag('cyan',   foreground=CYAN),
        }
        # Ширина колонки. Текст переносится по ширине окна, но не шире
        # читаемого предела: строка в две сотни знаков читается плохо —
        # глаз теряет начало следующей. Поэтому на широком экране текст
        # остаётся колонкой и стоит по центру, а не жмётся к левому краю.
        self.out_scroll.connect('size-allocate', self._fit_text_width)
        self.out_scroll.add(self.out_view)
        root.pack_start(self.out_scroll, True, True, 0)
        # Перенос настроек — только на экране «О программе». Плитками, как
        # в меню: вид один на всю программу. Импорт слева, экспорт справа —
        # под правую руку попадает безопасное действие: случайный экспорт
        # просто сохранит файл, а случайный импорт затёр бы настройки.
        self.about_bar = Gtk.Grid(column_spacing=12, row_spacing=12)
        self.about_bar.set_border_width(12)
        self.about_bar.set_column_homogeneous(True)
        self.about_bar.set_row_homogeneous(True)
        aacts = [
            ('import', self.t('imp_title'), '\u21e9', YELLOW, self.on_import),
            ('export', self.t('exp_title'), '\u21e7', GREEN,  self.on_export),
        ]
        aacts = self._apply_order('about', aacts)
        atiles = []
        for i, (key, label, glyph, color, handler) in enumerate(aacts):
            tile = self._make_tile(label, glyph, color,
                                   lambda _b, h=handler: h())
            self._hoverable(tile)
            self._make_draggable(tile, key, 'about')
            atiles.append(tile)
            self.about_bar.attach(tile, i, 0, 1, 1)
        self._grids['about'] = (self.about_bar, atiles, ['import', 'export'])
        # Обычная высота плитки, без растяжки. На этом экране главное —
        # описание и руководство, а перенос настроек делают раз в жизни:
        # растянутые на треть экрана плитки перетягивали внимание на себя.
        root.pack_start(self.about_bar, False, False, 0)

        self.bottom_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                                  spacing=10)
        self.bottom_bar.get_style_context().add_class('header')
        self.bottom_bar.set_border_width(12)
        save_all = Gtk.Button()
        save_all.get_style_context().add_class('mini')
        save_all.add(self._lbl(self.t('log_save'), CYAN, bold=True))
        save_all.connect('clicked', lambda _b: self.save_all_logs())
        self.bottom_bar.pack_start(save_all, False, False, 0)
        hint = Gtk.Label()
        hint.set_markup('<span foreground="%s" size="9000">%s</span>'
                        % (GRAY, self.t('report_note')))
        self.bottom_bar.pack_start(hint, False, False, 0)
        root.pack_start(self.bottom_bar, False, False, 0)
        return root

    def _hover_focus(self, w, _e, idx=None):
        """Мышь перехватывает рамку фокуса, чтобы клавиатура продолжила
        с того места, где пользователь остановился курсором."""
        try:
            if w.get_sensitive() and not w.has_focus():
                w.grab_focus()
            if idx is not None:
                self.focus_idx = idx
            elif w in self.tiles:
                self.focus_idx = self.tiles.index(w)
        except Exception:
            pass
        return False

    # ── перетаскивание плиток ─────────────────────────────────────────
    def _make_draggable(self, tile, key, grid_name):
        """Плитку можно перетащить на место другой; порядок запоминается.

        Gtk.Button забирает нажатие себе и штатный drag_source_set на нём
        не срабатывает, поэтому перетаскивание запускаем руками по порогу
        смещения — клик при этом продолжает работать как обычно.
        """
        tile._key = key
        tile._grid_name = grid_name
        entries = [Gtk.TargetEntry.new('ASC_TILE',
                                       Gtk.TargetFlags.SAME_APP, 0)]
        if not hasattr(self, '_tile_tlist'):
            self._tile_tlist = Gtk.TargetList.new(entries)
        tile.drag_dest_set(Gtk.DestDefaults.ALL, entries, Gdk.DragAction.MOVE)
        tile.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                        | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.BUTTON1_MOTION_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK)
        tile.connect('drag-data-get', self._tile_drag_get)
        tile.connect('drag-data-received', self._tile_drag_recv)
        tile.connect('drag-begin', self._tile_drag_begin)
        tile.connect('drag-end', self._tile_drag_end)
        tile.connect('drag-motion', self._tile_drag_motion)
        tile.connect('drag-leave', self._tile_drag_leave)
        tile.connect('drag-end', self._tile_drag_end)
        tile.connect('drag-motion', self._tile_drag_motion)
        tile.connect('drag-leave', self._tile_drag_leave)
        tile.connect('button-press-event', self._tile_press)
        tile.connect('motion-notify-event', self._tile_motion)
        tile.connect('button-release-event', self._tile_release)
        return tile

    def _drag_threshold(self):
        """Порог, после которого нажатие считается перетаскиванием."""
        v = getattr(self, '_dnd_thr', None)
        if v is None:
            try:
                v = Gtk.Settings.get_default().get_property(
                    'gtk-dnd-drag-threshold')
            except Exception:
                v = 8
            v = int(v) if v else 8
            self._dnd_thr = v
        return v

    def _tile_press(self, tile, ev):
        _dbg('press кнопка=%s плитка=%s' % (ev.button, tile._key))
        if ev.button == 3:
            return self._tile_menu(tile, ev)
        if ev.button == 1:
            self._drag_from = (tile, ev.x_root, ev.y_root)
        return False

    def _tile_motion(self, tile, ev):
        d = getattr(self, '_drag_from', None)
        if not d:
            _dbg('motion без нажатия')
            return False
        if d[0] is not tile:
            return False
        if not (ev.state & Gdk.ModifierType.BUTTON1_MASK):
            _dbg('motion: кнопка отпущена, сброс')
            self._drag_from = None
            return False
        # Gtk.drag_check_threshold в Python-привязках отсутствует —
        # сравниваем сами с системным порогом перетаскивания
        far = (abs(ev.x_root - d[1]) > self._drag_threshold()
               or abs(ev.y_root - d[2]) > self._drag_threshold())
        _dbg('motion сдвиг=%d,%d порог=%s'
             % (int(ev.x_root - d[1]), int(ev.y_root - d[2]), far))
        if far:
            self._drag_from = None
            try:
                ctx = tile.drag_begin_with_coordinates(
                    self._tile_tlist, Gdk.DragAction.MOVE, 1, ev, -1, -1)
                _dbg('drag_begin вернул', ctx)
            except Exception as e:
                _dbg('drag_begin ОШИБКА:', e)
            return True
        return False

    def _tile_release(self, _tile, _ev):
        self._drag_from = None
        return False

    def _tile_menu(self, tile, ev):
        if ev.button != 3:
            return False
        menu = Gtk.Menu()
        item = Gtk.MenuItem(label=self.t('tiles_reset'))
        item.connect('activate',
                     lambda _i, n=tile._grid_name: self._reset_order(n))
        item.show()
        menu.append(item)
        menu.attach_to_widget(tile, None)
        menu.popup_at_pointer(ev)
        return True

    def _reset_order(self, grid_name):
        grid, tiles, defaults = self._grids.get(grid_name,
                                                (None, None, None))
        if grid is None:
            return
        by_key = {t._key: t for t in tiles}
        ordered = [by_key[k] for k in defaults if k in by_key]
        ordered += [t for t in tiles if t._key not in defaults]
        tiles[:] = ordered
        self._relayout_grid(grid, tiles)
        self._save_order(grid_name, [])
        self._show_toast(self.t('tiles_reset_done'))

    def _tile_drag_begin(self, tile, ctx):
        """Под курсором едет сама плитка — так видно, что её оторвали."""
        _dbg('сигнал drag-begin от', tile._key)
        tile.get_style_context().add_class('dragging')
        try:
            import cairo
            alloc = tile.get_allocation()
            surf = tile.get_window().create_similar_surface(
                cairo.Content.COLOR_ALPHA, alloc.width, alloc.height)
            cr = cairo.Context(surf)
            tile.draw(cr)
            # курсор держит плитку за то место, где её взяли
            surf.set_device_offset(-alloc.width / 2.0, -alloc.height / 2.0)
            Gtk.drag_set_icon_surface(ctx, surf)
            _dbg('снимок плитки под курсором')
            return
        except Exception as e:
            _dbg('снимок не вышел:', e)
        try:
            Gtk.drag_set_icon_name(ctx, 'autoswitch', 32, 32)
        except Exception:
            pass

    def _tile_drag_end(self, tile, _ctx):
        tile.get_style_context().remove_class('dragging')
        for name in self._grids:
            _g, tiles, _d = self._grids[name]
            for t in tiles:
                t.get_style_context().remove_class('droptarget')

    def _tile_drag_motion(self, tile, ctx, _x, _y, time):
        tile.get_style_context().add_class('droptarget')
        Gdk.drag_status(ctx, Gdk.DragAction.MOVE, time)
        return True

    def _tile_drag_leave(self, tile, _ctx, _time):
        tile.get_style_context().remove_class('droptarget')

    def _tile_drag_get(self, tile, _ctx, data, _info, _time):
        # Кладём данные под тем же типом, который объявлен целью
        # (ASC_TILE). set_text подменил бы тип на текстовый, цель такой
        # не ждёт — и передача обрывалась молча, без ошибки.
        _dbg('drag-data-get от', tile._key)
        try:
            data.set(data.get_target(), 8, tile._key.encode('utf-8'))
        except Exception as e:
            _dbg('set данных ОШИБКА:', e)

    def _tile_drag_recv(self, target, _ctx, _x, _y, data, _info, _time):
        raw = None
        try:
            raw = data.get_data()
        except Exception as e:
            _dbg('get данных ОШИБКА:', e)
        src_key = raw.decode('utf-8', 'replace') if raw else None
        _dbg('drag-data-received: на %s пришло %r' % (target._key, src_key))
        if not src_key or src_key == target._key:
            return
        grid_name = target._grid_name
        grid, tiles, _def = self._grids.get(grid_name,
                                            (None, None, None))
        if grid is None:
            return
        keys = [t._key for t in tiles]
        if src_key not in keys or target._key not in keys:
            return
        # Меняем плитки местами. Раньше исходную вырезали и вставляли
        # перед целью — но после вырезания индекс цели съезжал, и при
        # перетаскивании слева направо плитка возвращалась на своё же
        # место. Обмен симметричен и работает в любую сторону.
        i_src = keys.index(src_key)
        i_dst = keys.index(target._key)
        tiles[i_src], tiles[i_dst] = tiles[i_dst], tiles[i_src]
        src = tiles[i_dst]
        self._relayout_grid(grid, tiles)
        self._save_order(grid_name, [t._key for t in tiles])
        if grid_name == 'main':
            self.tiles = tiles
            self.focus_idx = tiles.index(src)
        GLib.idle_add(src.grab_focus)

    def _relayout_grid(self, grid, tiles):
        for t in tiles:
            grid.remove(t)
        for i, t in enumerate(tiles):
            grid.attach(t, i % 2, i // 2, 1, 1)
        grid.show_all()

    def _row_target(self, row):
        return (getattr(row, '_chk', None) or getattr(row, '_btn', None)
                or row)

    def _focus_row(self, row):
        try:
            self._row_target(row).grab_focus()
        except Exception:
            pass
        return False

    def _focus_first(self, listbox):
        rows = [r for r in listbox.get_children() if r.get_visible()]
        if rows:
            self._focus_row(rows[0])
        return False

    def _focused_row(self):
        w = self.get_focus()
        while w is not None and not isinstance(w, Gtk.ListBoxRow):
            w = w.get_parent()
        return w

    def _list_nav(self, key, d):
        """W/S — по строкам, A/D — между колонками, как в главном меню."""
        row = self._focused_row()
        if row is None:
            self._focus_first(self.ex_listbox)
            return True
        lb = row.get_parent()
        rows = [r for r in lb.get_children() if r.get_visible()]
        if row not in rows:
            return False
        idx = rows.index(row)
        if d == 'up' or key == Gdk.KEY_Up:
            self._focus_row(rows[max(0, idx - 1)])
            return True
        if d == 'down' or key == Gdk.KEY_Down:
            self._focus_row(rows[min(len(rows) - 1, idx + 1)])
            return True
        if d in ('left', 'right') or key in (Gdk.KEY_Left, Gdk.KEY_Right):
            other = (self.ex_added_box if lb is self.ex_listbox
                     else self.ex_listbox)
            self._focus_first(other)
            return True
        return False

    def _activate_focused(self):
        """Enter работает как пробел: отмечает галочку или жмёт кнопку."""
        w = self.get_focus()
        if isinstance(w, Gtk.ListBoxRow):
            w = self._row_target(w)
        if isinstance(w, Gtk.CheckButton):
            w.set_active(not w.get_active())
            return True
        if isinstance(w, Gtk.Button):
            w.clicked()
            return True
        return False

    def _click_focus(self, _w, _e, target):
        try:
            if target.get_sensitive() and not target.has_focus():
                target.grab_focus()
        except Exception:
            pass
        return False

    def _clickable(self, row, target):
        row.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        row.connect('button-press-event', self._click_focus, target)
        return row

    def _hoverable(self, w, idx=None):
        w.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK)
        w.connect('enter-notify-event', self._hover_focus, idx)
        return w

    def _reg_compact(self, lbl, full, short, color):
        self._compact.append((lbl, full, short, color))

    def _apply_compact(self, narrow):
        if narrow == self._is_compact:
            return
        self._is_compact = narrow
        for lbl, full, short, color in self._compact:
            lbl.set_markup('<span foreground="%s" weight="bold">%s</span>'
                           % (color, short if narrow else full))

    def _soften(self, w):
        """Длинные подписи сжимаются вместо того, чтобы держать ширину окна.
        Кнопки топбара (.mini) и выпадающие списки не трогаем."""
        try:
            if isinstance(w, Gtk.ComboBox):
                return
            if isinstance(w, Gtk.Button) and \
                    w.get_style_context().has_class('mini'):
                return
            if isinstance(w, Gtk.Label):
                if not w.get_line_wrap():
                    w.set_ellipsize(Pango.EllipsizeMode.END)
                return
            if isinstance(w, Gtk.Container):
                for ch in w.get_children():
                    self._soften(ch)
        except Exception:
            pass

    def _ellipsize_check(self, chk):
        """Длинные подписи обрезаем — иначе окно нельзя сузить."""
        try:
            lb = chk.get_child()
            if isinstance(lb, Gtk.Label):
                lb.set_ellipsize(Pango.EllipsizeMode.END)
                lb.set_halign(Gtk.Align.START)
        except Exception:
            pass

    def _lbl(self, text, color, bold=False):
        lb = Gtk.Label()
        w = ' weight="bold"' if bold else ''
        lb.set_markup('<span foreground="%s"%s>%s</span>' % (color, w, text))
        return lb

    # ── экран настроек (в том же окне) ────────────────────────────────
    def _build_settings(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.get_style_context().add_class('settings-screen')
        bar, _ = self._topbar(self.t('set_title'))
        root.pack_start(bar, False, False, 0)

        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        inner.set_border_width(20)
        inner.get_style_context().add_class('settings-body')

        # Индикатор
        r1 = Gtk.Box(spacing=10)
        r1.pack_start(self._lbl(self.t('set_indicator') + ':', CYAN),
                      False, False, 0)
        sw = Gtk.Switch()
        sw.set_active(cfg_get('show_indicator', 'on') == 'on')
        sw.connect('notify::active',
                   lambda s, _p: cfg_set('show_indicator',
                                         'on' if s.get_active() else 'off'))
        r1.pack_end(sw, False, False, 0)
        inner.pack_start(r1, False, False, 0)

        inner.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL),
                         False, False, 6)

        # Действия — плитками 2x2, как в главном меню (растягиваются)
        sgrid = Gtk.Grid()
        sgrid.set_row_spacing(12); sgrid.set_column_spacing(12)
        sgrid.set_row_homogeneous(True); sgrid.set_column_homogeneous(True)
        sgrid.set_vexpand(True); sgrid.set_hexpand(True)
        acts = [
            ('config', self.t('set_config'), '\u270e', YELLOW,
             self._edit_config),
            ('excl',   self.t('set_excl'),   '\u2298', CYAN,
             self._show_exclusions),
            ('lang',   self.t('set_lang'),   '\u21c6', PURPLE,
             self._toggle_lang),
            ('techdict', self.t('m_techdict'), '\u2261', GREEN,
             self._show_techdict),
        ]
        acts = self._apply_order('settings', acts)
        stiles = []
        for i, (key, label, glyph, color, handler) in enumerate(acts):
            tile = self._make_tile(label, glyph, color,
                                   lambda _b, h=handler: h())
            self._hoverable(tile)
            self._make_draggable(tile, key, 'settings')
            stiles.append(tile)
            sgrid.attach(tile, i % 2, i // 2, 1, 1)
        self._grids['settings'] = (sgrid, stiles,
                                   ['config', 'excl', 'lang', 'techdict'])
        inner.pack_start(sgrid, True, True, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(inner)
        root.pack_start(scroll, True, True, 0)
        return root

    def _settings_btn(self, label, color, handler):
        btn = Gtk.Button()
        btn.get_style_context().add_class('setrow')
        btn.add(self._lbl(label, color, bold=True))
        btn.connect('clicked', handler)
        return btn

