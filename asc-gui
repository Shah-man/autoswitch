    # ── перенос настроек: экспорт и импорт ────────────────────────────
    # Формат нарочно текстовый, а не архив: человек может открыть файл
    # блокнотом, посмотреть, что увозит, и при нужде поправить руками.
    EXPORT_MARK = '# autoswitch settings export'

    def _export_text(self):
        """Собрать файл переноса: настройки + «Мой словарь»."""
        try:
            with open(CONFIG, encoding='utf-8', errors='replace') as f:
                conf = f.read()
        except OSError:
            conf = ''
        try:
            with open(LEARNED, encoding='utf-8', errors='replace') as f:
                learned = f.read()
        except OSError:
            learned = ''
        now = datetime.datetime.now().strftime('%Y-%m-%d %H:%M')
        head = (self.EXPORT_MARK + '\n'
                '# version=1  date=%s\n'
                '# %s\n'
                '# %s\n\n' % (now, self.t('exp_hint'), self.t('imp_hint')))
        return head + '[config]\n' + conf.rstrip('\n') + \
            '\n\n[learned]\n' + learned.rstrip('\n') + '\n'

    @staticmethod
    def _parse_export(text):
        """Разобрать файл переноса на две части.

        Возвращает (конфиг, строки словаря) или (None, None), если это
        не наш файл — тогда ничего не трогаем.
        """
        if not text.lstrip().startswith('# autoswitch settings export'):
            return None, None
        conf, learned, where = [], [], None
        for line in text.splitlines():
            if line.strip() == '[config]':
                where = 'c'; continue
            if line.strip() == '[learned]':
                where = 'l'; continue
            if where == 'c':
                conf.append(line)
            elif where == 'l':
                learned.append(line)
        return '\n'.join(conf).strip() + '\n', learned

    @staticmethod
    def _merge_learned(imported):
        """Слить словарь: свои слова + принесённые, принесённые главнее.

        Ключ — само слово, поэтому дубликатов не возникает: одинаковые
        просто накладываются друг на друга. Конфликт бывает один —
        слово есть в обоих, но с разным языком; берём из файла, ведь
        человек принёс его осознанно.
        """
        words = {}
        for src in (None, imported):
            lines = []
            if src is None:
                try:
                    with open(LEARNED, encoding='utf-8',
                              errors='replace') as f:
                        lines = f.read().splitlines()
                except OSError:
                    lines = []
            else:
                lines = src
            for ln in lines:
                ln = ln.strip()
                if not ln or ln.startswith('#'):
                    continue
                parts = ln.replace('\t', ' ').split()
                if not parts:
                    continue
                lang = parts[1].lower() if len(parts) > 1 else 'us'
                words[parts[0].lower()] = lang if lang in ('ru', 'us') else 'us'
        return words

    def on_export(self):
        now = datetime.datetime.now()
        fname = 'autoswitch-settings-%s.txt' % now.strftime('%Y%m%d')
        path = self._file_save(fname, self._export_text())
        if path:
            self._show_toast(self.t('exp_done').format(f=path), ms=5000)

    def on_import(self):
        dlg = Gtk.FileChooserDialog(title=self.t('imp_btn'), parent=self,
                                    action=Gtk.FileChooserAction.OPEN)
        dlg.add_buttons(self.t('cancel'), Gtk.ResponseType.CANCEL,
                        self.t('imp_btn'), Gtk.ResponseType.OK)
        path = None
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
        dlg.destroy()
        if not path:
            return
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                text = f.read()
        except OSError:
            self._show_toast(self.t('imp_bad'))
            return
        conf, learned = self._parse_export(text)
        if conf is None:
            self._show_toast(self.t('imp_bad'))
            return
        if not self._confirm(self.t('imp_ask'),
                             self.t('imp_ask_m').format(f=path)):
            return
        words = self._merge_learned(learned)
        payload = '\n'.join('%s\t%s' % (w, l) for w, l in sorted(words.items()))
        run(['pkexec', HELPER, 'write-config'], input_text=conf)
        run(['pkexec', HELPER, 'write-learned'], input_text=payload + '\n')
        poke_indicator()
        self._auto_restart()
        # дольше обычного: человек должен успеть прочитать итог
        self._show_toast(self.t('imp_done').format(n=len(words)), ms=6000)

    def save_all_logs(self):
        text = diag_report(self.t)
        nlines = len(svc_log_all().splitlines())
        now = datetime.datetime.now()
        fname = 'autoswitch-%s-%s-%d.log' % (
            now.strftime('%Y%m%d'), now.strftime('%H%M'), nlines)
        self._file_save(fname, text)

    # ── настройки: язык / перезапуск / конфиг ─────────────────────────
    def _toggle_lang(self):
        self.lang = 'en' if self.lang == 'ru' else 'ru'
        cfg_set('ui_lang', self.lang)
        # перевыпустить конфиг на новом языке, сохранив значения
        run(['pkexec', HELPER, 'relang-config', self.lang])
        GLib.idle_add(self._relang)

    def _auto_restart(self):
        # тихо перезапускаем службу, чтобы настройки применились сами
        rc, out = svc_action('restart')
        if rc == 0:
            self._show_toast(self.t('r_restarting'))

    def _on_lang_change(self, combo):
        new = combo.get_active_id() or 'ru'
        if new != self.lang:
            cfg_set('ui_lang', new)
            self.lang = new
            run(['pkexec', HELPER, 'relang-config', new])
            # перестройку откладываем: нельзя рушить combo прямо в его же
            # обработчике changed — иначе сегфолт. idle_add даёт GTK
            # завершить обработку сигнала.
            GLib.idle_add(self._relang)

    def _show_toast(self, text, ms=1500):
        self.toast.set_markup(
            '<span foreground="#000000" weight="bold"> %s </span>' % text)
        self.toast.show()
        if self._toast_id:
            GLib.source_remove(self._toast_id)
        self._toast_id = GLib.timeout_add(ms, self._hide_toast)

    def _hide_toast(self):
        self.toast.hide()
        self._toast_id = None
        return False

    def _restart_now(self):
        rc, out = svc_action('restart')
        if rc != 0 and ('dismiss' in out.lower()
                        or 'not authorized' in out.lower()):
            return
        self.refresh_status()
        self._show_toast(self.t('r_restarting'))

    def _build_edit(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        bar, self.edit_title = self._topbar(self.t('set_config'))
        # кнопка Сохранить справа от Назад
        save = Gtk.Button()
        save.get_style_context().add_class('mini')
        slbl = self._lbl(self.t('save'), GREEN, bold=True)
        save.add(slbl)
        save.set_tooltip_text(self.t('save'))
        self._reg_compact(slbl, self.t('save'), '\u2713', GREEN)
        self._hoverable(save)
        save.connect('clicked', lambda _b: self._edit_save())
        bar.pack_end(save, False, False, 0)
        root.pack_start(bar, False, False, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.edit_view = Gtk.TextView()
        self.edit_view.set_monospace(True)
        self.edit_view.set_cursor_visible(True)
        self.edit_view.get_style_context().add_class('output')
        self.edit_view.set_left_margin(12); self.edit_view.set_right_margin(12)
        self.edit_view.set_top_margin(10)
        self.edit_buf = self.edit_view.get_buffer()
        scroll.add(self.edit_view)
        root.pack_start(scroll, True, True, 0)
        self._edit_path = CONFIG
        return root

    def _edit_config(self):
        # правим конфиг во встроенном экране (без запуска root-редактора,
        # который не имеет доступа к дисплею пользователя)
        try:
            with open(CONFIG) as f:
                _orig = f.read()
        except Exception:
            _orig = '# %s\n' % CONFIG
        self.edit_buf.set_text(_orig)
        # запоминаем исходный текст: если пользователь ничего не менял,
        # службу дёргать незачем — она бы зря отключилась на секунду
        self._edit_orig = _orig
        self._edit_path = CONFIG
        self.edit_title.set_markup(
            '<span foreground="%s" weight="bold">%s</span>'
            % (CYAN, self.t('set_config')))
        self._nav_to('edit')
        GLib.idle_add(self.edit_view.grab_focus)

    def _edit_save(self):
        s, e = self.edit_buf.get_bounds()
        text = self.edit_buf.get_text(s, e, True)
        # Ничего не изменилось — не пишем и не трогаем службу.
        if text == getattr(self, '_edit_orig', None):
            self._nav_back()
            self._show_toast(self.t('cfg_unchanged'))
            return
        try:
            run(['pkexec', HELPER, 'write-config'], input_text=text)
            # Служба читает конфиг только при старте, поэтому после правки
            # её надо перезапустить — иначе настройка «не работает», и
            # человек решает, что программа сломана.
            run(['pkexec', HELPER, 'service', 'restart'])
            poke_indicator()
            self._edit_orig = text
            self._nav_back()
            self._show_toast(self.t('cfg_saved_restarted'))
            self.refresh_status()
            return
        except Exception:
            pass
        self._nav_back()

