CONFIG = '/etc/autoswitch/config'


# Конфиг читают два цикла (видимость раз в 2 сек, состояние раз в 3 сек)
# плюс проверка языка. Файл крошечный, но открывать его пять раз в секунду
# незачем — держим разобранные значения и перечитываем только по mtime.
_cfg_cache = {'mtime': -1.0, 'data': {}}


def _cfg_all():
    try:
        mt = os.path.getmtime(CONFIG)
    except OSError:
        return _cfg_cache['data']
    if mt != _cfg_cache['mtime']:
        data = {}
        try:
            with open(CONFIG, encoding='utf-8') as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith('#') or '=' not in line:
                        continue
                    k, v = line.split('=', 1)
                    data[k.strip()] = v.strip()
        except Exception:
            return _cfg_cache['data']
        _cfg_cache['mtime'] = mt
        _cfg_cache['data'] = data
    return _cfg_cache['data']


def _indicator_enabled():
    """Читать show_indicator из конфига. По умолчанию on."""
    val = _cfg_all().get('show_indicator', '').lower()
    return val not in ('off', '0', 'no', 'false')


# --- язык интерфейса: общий с asc/asc-gui через ui_lang в конфиге ---
def _ui_lang():
    """ru|en из конфига; если не задан — по системной локали."""
    v = _cfg_all().get('ui_lang', '').lower()
    if v in ('ru', 'en'):
        return v
    loc = (os.environ.get('LC_ALL') or os.environ.get('LC_MESSAGES')
           or os.environ.get('LANG') or '')
    return 'ru' if loc.lower().startswith('ru') else 'en'


