WATCHER = 'org.kde.StatusNotifierWatcher'
SNI_PATH = '/StatusNotifierItem'


class SNIItem:
    """Значок в трее без libayatana.

    Смысл затеи — левый клик. libayatana обязательно экспортирует меню, а
    панель, увидев меню, показывает его сама и метод Activate нам не шлёт.
    Объявляя себя StatusNotifierItem напрямую, мы меню не отдаём и ставим
    ItemIsMenu=false — тогда панель обязана слать Activate, и нажатие на
    значок становится нашим. Заодно исчезает привязка к версии панели:
    это чистый D-Bus, одинаковый в LXQt, Plasma и waybar.
    """

    def __init__(self, item_id, title, theme_path,
                 on_activate=None, on_secondary=None, on_context=None):
        self.item_id = item_id
        self.title = title
        self.theme_path = theme_path
        self.icon_name = ''
        self.icon_pixmap = None   # (ширина, высота, байты ARGB32)
        self.status = 'Active'
        self._on_activate = on_activate
        self._on_secondary = on_secondary
        self._on_context = on_context
        self._reg_id = None
        self.ok = False

        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        info = Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0]
        self._reg_id = self.bus.register_object(
            SNI_PATH, info, self._call, self._get, None
        )
        self.bus_name = 'org.kde.StatusNotifierItem-%d-1' % os.getpid()
        self._own_id = None
        self._claim()
        # Панель могут перезапустить — тогда наблюдатель поднимется заново
        # и про нас забудет. Следим за появлением имени и объявляемся снова.
        self._watch_id = Gio.bus_watch_name_on_connection(
            self.bus, WATCHER, Gio.BusNameWatcherFlags.NONE,
            lambda *a: self._register(), None
        )
        self._register()

    def dispose(self):
        """Полностью убрать себя с шины.

        Нужно, когда мы отказались от своего значка в пользу libayatana:
        брошенный объект иначе продолжает жить (его держит наблюдатель
        имени) и позже объявляется у панели сам. Тогда в одном процессе
        оказываются два значка, и клики достаются то одному, то другому.
        """
        try:
            if self._watch_id is not None:
                Gio.bus_unwatch_name(self._watch_id)
                self._watch_id = None
        except Exception:
            pass
        self._release()
        try:
            if self._reg_id is not None:
                self.bus.unregister_object(self._reg_id)
                self._reg_id = None
        except Exception:
            pass
        self.ok = False

    def _claim(self):
        if self._own_id is not None:
            return
        self._own_id = Gio.bus_own_name_on_connection(
            self.bus, self.bus_name, Gio.BusNameOwnerFlags.NONE, None, None
        )

    def _release(self):
        if self._own_id is None:
            return
        try:
            Gio.bus_unown_name(self._own_id)
        except Exception:
            pass
        self._own_id = None

    def _register(self):
        try:
            self.bus.call_sync(
                WATCHER, '/StatusNotifierWatcher', WATCHER,
                'RegisterStatusNotifierItem',
                GLib.Variant('(s)', (self.bus_name,)),
                None, Gio.DBusCallFlags.NONE, 3000, None
            )
            self.ok = True
        except Exception:
            pass

    def _get(self, _conn, _sender, _path, _iface, name):
        if name == 'Category':
            return GLib.Variant('s', 'ApplicationStatus')
        if name == 'Id':
            return GLib.Variant('s', self.item_id)
        if name == 'Title':
            return GLib.Variant('s', self.title)
        if name == 'Status':
            return GLib.Variant('s', self.status)
        if name == 'IconName':
            return GLib.Variant('s', self.icon_name)
        if name == 'IconThemePath':
            return GLib.Variant('s', self.theme_path)
        if name == 'IconPixmap':
            # Пиксели вместо имени. Имя панель ищет сама, в своём кеше
            # иконочной темы: меняем размер точки — меняется имя файла,
            # панель про новый файл ещё не знает и рисует заглушку
            # «иконка не найдена» — тот самый квадратик. Причём через раз:
            # если этим размером уже пользовались, файл попал в кеш при
            # запуске панели и всё рисуется верно. Отдавая пиксели, мы
            # выбрасываем из цепочки и тему, и кеш, и имена файлов.
            if not self.icon_pixmap:
                return GLib.Variant('a(iiay)', [])
            w, h, data = self.icon_pixmap
            return GLib.Variant('a(iiay)', [(w, h, data)])
        if name == 'ItemIsMenu':
            return GLib.Variant('b', False)
        if name == 'ToolTip':
            return GLib.Variant('(sa(iiay)ss)',
                                ('', [], self.title, ''))
        return None

    def _call(self, _conn, _sender, _path, _iface, method, params, inv):
        # Панель присылает координаты значка на экране — по ним меню можно
        # поставить точно над ним, а не там, где случайно стоит курсор.
        try:
            x, y = params.unpack()
        except Exception:
            x = y = None
        if method == 'Activate' and self._on_activate:
            self._on_activate(x, y)
        elif method == 'SecondaryActivate' and self._on_secondary:
            self._on_secondary(x, y)
        elif method == 'ContextMenu' and self._on_context:
            self._on_context(x, y)
        inv.return_value(None)

    def _emit(self, signal, args=None):
        try:
            self.bus.emit_signal(
                None, SNI_PATH, 'org.kde.StatusNotifierItem', signal, args
            )
        except Exception:
            pass

    def set_icon(self, name_or_path):
        """Сменить значок: путь к файлу — отдаём пикселями, иначе именем.

        Пиксели надёжнее: панель не ищет файл в своём кеше темы и не
        показывает заглушку, когда имя ей ещё незнакомо.
        """
        if '/' in name_or_path:
            pm = _svg_to_argb32(name_or_path)
            if pm is not None:
                self.icon_pixmap = pm
                # имя обязано быть пустым: увидев непустое, панель
                # предпочтёт искать по нему и пиксели проигнорирует
                self.icon_name = ''
                self._emit('NewIcon')
                return
            # отрисовать не вышло — откатываемся на имя без расширения
            name_or_path = os.path.splitext(
                os.path.basename(name_or_path))[0]
        self.icon_pixmap = None
        self.icon_name = name_or_path
        self._emit('NewIcon')

    def set_status(self, active):
        """Показать или убрать значок.

        Одного статуса Passive мало: часть панелей, включая LXQt, рисует и
        такие значки. Поэтому при выключении уходим из шины совсем — панель
        видит, что нас больше нет, и убирает значок. При включении имя
        занимаем заново и объявляемся у наблюдателя.
        """
        want = 'Active' if active else 'Passive'
        if want == self.status and (self._own_id is not None) == active:
            return
        self.status = want
        if active:
            self._claim()
            self._register()
            self._emit('NewStatus', GLib.Variant('(s)', (self.status,)))
        else:
            self._emit('NewStatus', GLib.Variant('(s)', (self.status,)))
            self._release()


def _panel_edge(px, py, wa):
    """Найти край панели у точки (px, py).

    Рабочая область тут не помощник: панель LXQt место под себя не
    резервирует, и _NET_WORKAREA равна всему экрану. Зато сама панель —
    окно типа _NET_WM_WINDOW_TYPE_DOCK, и её геометрию можно спросить у X.

    Возвращает ('bottom', y) — панель снизу, y её верхний край;
    ('top', y) — панель сверху, y её нижний край; None — не нашлась.
    """
    try:
        from Xlib import display as _xd, X
    except Exception:
        return None
    try:
        d = _xd.Display()
    except Exception:
        return None
    try:
        root = d.screen().root
        a_type = d.get_atom('_NET_WM_WINDOW_TYPE')
        a_dock = d.get_atom('_NET_WM_WINDOW_TYPE_DOCK')
        mid = wa.y + wa.height / 2.0
        best = None
        docks = []

        def walk(w, depth=0):
            # Панель не обязана лежать среди детей root: Openbox и другие
            # менеджеры вешают её внутрь своей рамки. Двух уровней хватает.
            if depth > 3:
                return
            try:
                kids = w.query_tree().children
            except Exception:
                return
            for k in kids:
                try:
                    p = k.get_full_property(a_type, X.AnyPropertyType)
                    if p and a_dock in list(p.value):
                        g = k.get_geometry()
                        t = k.translate_coords(root, 0, 0)
                        docks.append((-t.x, -t.y, g.width, g.height))
                except Exception:
                    pass
                walk(k, depth + 1)

        walk(root)
        for wx, wy, ww, wh in docks:
            if ww < wh or ww < 2 or wh < 2:
                continue  # вертикальные панели и окна-пустышки
            if not (wx <= px <= wx + ww):
                continue
            if wy + wh / 2.0 > mid:
                cand = ('bottom', wy)
            else:
                cand = ('top', wy + wh)
            if best is None or abs(cand[1] - py) < abs(best[1] - py):
                best = cand
        return best
    except Exception:
        return None
    finally:
        try:
            d.close()
        except Exception:
            pass


def _pick_backend():
    """Выбрать способ показа значка.

    StatusIcon (XEmbed) даёт меню с цветом и разметкой, но XEmbed есть
    не везде: KDE Plasma 6 его убрала, а wlroots-композиторы (sway,
    Hyprland) не имели никогда — там трей работает только по протоколу
    StatusNotifierItem, то есть через AppIndicator. Меню в этом случае
    уходит панели через DBusMenu, и разметка с цветом теряются.

    Поэтому: Wayland (кроме GNOME) и Plasma — AppIndicator,
    всё остальное — StatusIcon.

    Переопределить можно переменной окружения:
        AUTOSWITCH_TRAY=appindicator | statusicon
    """
    forced = (os.environ.get('AUTOSWITCH_TRAY') or '').strip().lower()
    if forced == 'statusicon':
        return 'statusicon'
    if forced == 'appindicator':
        return 'appindicator' if _Ind else 'statusicon'

    desktop = (os.environ.get('XDG_CURRENT_DESKTOP') or '').lower()
    session = (os.environ.get('DESKTOP_SESSION') or '').lower()
    stype = (os.environ.get('XDG_SESSION_TYPE') or '').lower()

    both = desktop + ' ' + session
    is_plasma = any(k in both for k in ('kde', 'plasma'))
    # wlroots-композиторы (sway, Hyprland) XEmbed не умеют вовсе: трей там
    # даёт waybar и подобные, и только по протоколу SNI.
    is_wlroots = any(k in both for k in ('sway', 'hyprland', 'river', 'wayfire'))
    # прочие Wayland-сессии, кроме GNOME (там значок даёт расширение)
    is_other_wayland = (stype == 'wayland' and 'gnome' not in both)

    if _Ind is not None and (is_plasma or is_wlroots or is_other_wayland):
        return 'appindicator'
    # X11 без XEmbed-лотка (LXQt 2 и подобные): StatusIcon показывать негде
    if _Ind is not None and stype != 'wayland' and not _xembed_tray_present():
        return 'appindicator'
    return 'statusicon'


