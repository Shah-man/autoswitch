# Сколько ждать появления XEmbed-лотка при старте сессии. В автозапуске
# индикатор и панель поднимаются разом, и лоток заявляет о себе не мгновенно:
# без ожидания проверка соврёт и на XFCE значок уедет в AppIndicator.
_TRAY_WAIT = 3.0


def _xembed_tray_present(timeout=_TRAY_WAIT):
    """Есть ли на экране XEmbed-лоток.

    Лоток объявляет себя владельцем выделения _NET_SYSTEM_TRAY_S<номер экрана>.
    Нет владельца — Gtk.StatusIcon рисовать негде, значок не появится вовсе
    (панель LXQt 2 даёт только StatusNotifier, старый лоток из неё убран).
    Спрашиваем у X напрямую, а не гадаем по имени окружения.

    Ждём до timeout секунд: выходим сразу, как только владелец найден.
    При любой ошибке отвечаем True — то есть остаёмся на прежнем поведении.
    """
    try:
        from Xlib import display as _xd
    except Exception:
        return True
    try:
        d = _xd.Display()
    except Exception:
        return True
    try:
        atom = d.get_atom('_NET_SYSTEM_TRAY_S%d' % d.get_default_screen())
        deadline = time.monotonic() + max(0.0, timeout)
        while True:
            if d.get_selection_owner(atom):
                return True
            if time.monotonic() >= deadline:
                return False
            time.sleep(0.25)
    except Exception:
        return True
    finally:
        try:
            d.close()
        except Exception:
            pass


def _svg_to_argb32(path, size=22):
    """Отрисовать SVG и вернуть (ширина, высота, байты) для IconPixmap.

    Формат задан спецификацией StatusNotifierItem: ARGB32, по строкам,
    сетевой порядок байт — то есть каждый пиксель это A, R, G, B. У
    GdkPixbuf порядок другой (R, G, B, A), поэтому переставляем.
    """
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
        if not pb.get_has_alpha():
            pb = pb.add_alpha(False, 0, 0, 0)
        w, h = pb.get_width(), pb.get_height()
        stride = pb.get_rowstride()
        src = pb.get_pixels()
        out = bytearray(w * h * 4)
        i = 0
        for row in range(h):
            base = row * stride
            for col in range(w):
                o = base + col * 4
                out[i] = src[o + 3]      # A
                out[i + 1] = src[o]      # R
                out[i + 2] = src[o + 1]  # G
                out[i + 3] = src[o + 2]  # B
                i += 4
        return w, h, bytes(out)
    except Exception:
        return None


