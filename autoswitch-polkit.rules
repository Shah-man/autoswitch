// Разрешает управлять ТОЛЬКО службой autoswitch.service без пароля.
// Это нужно для индикатора в панели (кнопки Старт/Стоп/Перезапуск).
// Безопасно: правило ограничено одной службой, не даёт прав на остальную систему.
// Устанавливается в /etc/polkit-1/rules.d/ установщиком.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit == "autoswitch.service") {
            // только для активных локальных сессий обычных пользователей
            if (subject.local && subject.active && subject.isInGroup("users")) {
                return polkit.Result.YES;
            }
            // на некоторых системах группа называется иначе — проверим uid>=1000
            if (subject.local && subject.active && subject.user != "root") {
                return polkit.Result.YES;
            }
        }
    }
    return polkit.Result.NOT_HANDLED;
});
