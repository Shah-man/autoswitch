# «всё в порядке, безопасно». Только при выводе на терминал: в файл или
# через конвейер уходит чистый текст, без управляющих кодов.
banner() {
    local c="" n=""
    if [ -t 1 ]; then c=$'\033[1;92m'; n=$'\033[0m'; fi
    printf '%s' "$c"
    cat << 'BANNER'
     _       _                 _ _      _
    /_\ _  _| |_ ___ ____ __ _(_) |_ __| |_
   / _ \ || |  _/ _ (_-< V  V / |  _/ _| ' \
  /_/ \_\_,_|\__\___/__/\_/\_/|_|\__\__|_||_|
            ___           __ _
           / __|___ _ _  / _(_)__ _
          | (__/ _ \ ' \|  _| / _` |
           \___\___/_||_|_| |_\__, |
                              |___/
BANNER
    printf '%s' "$n"
    echo
}

