# ---------------------------------------------------------------- дистрибутив
detect_distro() {
    local id="" like=""
    if [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        id="${ID:-}"
        like="${ID_LIKE:-}"
    fi
    case " $id $like " in
        *altlinux*)                 echo alt;    return ;;
        *debian*|*ubuntu*)          echo debian; return ;;
        *fedora*|*rhel*|*centos*)   echo fedora; return ;;
        *arch*)                     echo arch;   return ;;
        *suse*)                     echo suse;   return ;;
    esac
    # если os-release не помог — по пакетному менеджеру.
    # apt есть и в Debian, и в ALT, различаем по наличию rpm
    if command -v apt-get >/dev/null 2>&1; then
        if command -v rpm >/dev/null 2>&1; then echo alt; else echo debian; fi
    elif command -v dnf >/dev/null 2>&1 || command -v yum >/dev/null 2>&1; then
        echo fedora
    elif command -v pacman >/dev/null 2>&1; then
        echo arch
    elif command -v zypper >/dev/null 2>&1; then
        echo suse
    else
        echo unknown
    fi
}

DISTRO="$(detect_distro)"
tf distro "$DISTRO"

pm_update() {
    case "$DISTRO" in
        alt|debian) apt-get update -qq || true ;;
        arch)       pacman -Sy --noconfirm >/dev/null 2>&1 || true ;;
        *)          : ;;
    esac
}

# Установить пакет. Возвращает 0 при успехе, 1 при неудаче —
# вызывающий перебирает варианты имён дальше.
pm_install() {
    local pkg="$1"
    case "$DISTRO" in
        alt|debian) apt-get install -y "$pkg" >/dev/null 2>&1 ;;
        fedora)     { command -v dnf >/dev/null && dnf install -y "$pkg" \
                      || yum install -y "$pkg"; } >/dev/null 2>&1 ;;
        arch)       pacman -S --noconfirm "$pkg" >/dev/null 2>&1 ;;
        suse)       zypper --non-interactive install "$pkg" >/dev/null 2>&1 ;;
        *)          return 1 ;;
    esac
}

# ------------------------------------------------------- поиск словарей
# Движок читает /usr/share/hunspell/{ru_RU,en_US}.dic. Но дистрибутивы
# кладут словари по-разному: в myspell, в подкаталоги, под другими
# именами. Ищем файл где угодно, а потом подставим ссылку туда, где
# движок его ждёт.
find_dic() {
    local lang="$1" short="${1%%_*}" p
    for p in "/usr/share/hunspell/$lang.dic" \
             "/usr/share/myspell/$lang.dic" \
             "/usr/share/myspell/dicts/$lang.dic" \
             "/usr/share/hunspell/$short.dic" \
             "/usr/share/dict/hunspell/$lang.dic"; do
        [ -f "$p" ] && { echo "$p"; return 0; }
    done
    p="$(find /usr/share -maxdepth 4 -name "$lang.dic" 2>/dev/null | head -1)"
    [ -n "$p" ] && { echo "$p"; return 0; }
    return 1
}

# ------------------------------------------------------------- проверки нужд
have_dep() {
    case "$1" in
        evdev)   python3 -c "import evdev" 2>/dev/null ;;
        xlib)    python3 -c "import Xlib"  2>/dev/null ;;
        gi)      # Мало проверить импорт: если PyGObject не установлен, в
                 # некоторых системах остаётся пустой namespace-пакет gi,
                 # который импортируется, но ничего не умеет. Проверяем, что
                 # модуль настоящий — по наличию require_version.
                 python3 -c "import gi; gi.require_version" 2>/dev/null ;;
        gtk3)    python3 -c "import gi; gi.require_version('Gtk','3.0')" 2>/dev/null ;;
        appind)  python3 -c "import gi; gi.require_version('AyatanaAppIndicator3','0.1')" 2>/dev/null \
              || python3 -c "import gi; gi.require_version('AppIndicator3','0.1')" 2>/dev/null ;;
        lshell)  # мало самой библиотеки: Python видит её только через
                 # GIR-данные, а они кое-где лежат в отдельном пакете
                 python3 -c "import gi; gi.require_version('GtkLayerShell','0.1')" 2>/dev/null ;;
        vte)     python3 -c "import gi; gi.require_version('Vte','2.91')" 2>/dev/null ;;
        cairo)   python3 -c "import gi; gi.require_foreign('cairo')" 2>/dev/null ;;
        dialog)  command -v dialog >/dev/null 2>&1 ;;
        dict-ru) find_dic ru_RU >/dev/null ;;
        dict-en) find_dic en_US >/dev/null ;;
        *)       return 1 ;;
    esac
}

# Варианты имён пакетов, перебираются по порядку до первого успеха.
