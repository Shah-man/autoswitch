# Если ни одно известное имя не подошло — спрашиваем сам репозиторий.
# Имена пакетов со словарями в дистрибутивах разные и меняются, а поиск
# по репозиторию находит их независимо от того, как их назвали.
dep_search() {
    local dep="$1" pat found=""
    case "$dep" in
        dict-ru) pat='ru' ;;
        dict-en) pat='en' ;;
        # Имена пакетов с привязкой cairo к Python в дистрибутивах разные
        # и меняются. Если ни одно известное не подошло — спрашиваем
        # сам репозиторий, как и для словарей.
        cairo)
            case "$DISTRO" in
                alt|debian)
                    apt-cache search cairo 2>/dev/null | awk '{print $1}' \
                        | grep -E '^python3?-(module-)?(gi-)?(py)?cairo$' \
                        | head -6
                    ;;
                fedora)
                    dnf -q search cairo 2>/dev/null \
                        | awk -F. '/^python3-.*cairo/{print $1}' | head -6
                    ;;
                arch)
                    pacman -Ssq cairo 2>/dev/null \
                        | grep -E '^python-?cairo' | head -6
                    ;;
                suse)
                    zypper --quiet search cairo 2>/dev/null \
                        | awk -F'|' '/python3.*cairo/{gsub(/ /,"",$2); print $2}' \
                        | head -6
                    ;;
            esac
            return 0
            ;;
        *)       return 0 ;;
    esac
    case "$DISTRO" in
        alt|debian)
            found="$(apt-cache search hunspell 2>/dev/null | awk '{print $1}')"
            found="$found $(apt-cache search myspell 2>/dev/null | awk '{print $1}')"
            ;;
        fedora)
            found="$(dnf -q search hunspell 2>/dev/null | awk -F. '/^hunspell/{print $1}')"
            ;;
        arch)
            found="$(pacman -Ssq hunspell 2>/dev/null)"
            ;;
        suse)
            found="$(zypper --quiet search myspell 2>/dev/null | awk -F'|' '/^ *i?[ +] *\|/{gsub(/ /,"",$2); print $2}')"
            ;;
    esac
    # отбираем имена, где язык стоит отдельным куском: hunspell-ru,
    # hunspell-ru-lebedev, myspell-ru_RU. Проверка в два шага, чтобы
    # не поймать hunspell-ruby: там после "ru" идёт буква, а не разделитель.
    echo "$found" \
        | tr ' ' '\n' \
        | grep -E '^(hunspell|myspell)-' \
        | grep -E "[-_]${pat}([-_]|\$)" \
        | head -8
}

UPDATED=0
ensure_dep() {
    local dep="$1" optional="${2:-no}" cand ok=1
    if have_dep "$dep"; then
        tf dep_have "$(dep_human "$dep")"
        return 0
    fi
    if [ "$UPDATED" -eq 0 ]; then
        pm_update
        UPDATED=1
    fi
    for cand in $(dep_candidates "$dep") $(dep_search "$dep"); do
        if pm_install "$cand"; then
            if have_dep "$dep"; then
                tf dep_inst "$(dep_human "$dep")" "$cand"
                ok=0
                break
            fi
        fi
    done
    if [ "$ok" -ne 0 ]; then
        if [ "$optional" = optional ]; then
            tf dep_skip "$(dep_human "$dep")"
            return 0
        fi
        tf dep_nfail "$(dep_human "$dep")"
        tf dep_tried "$(dep_candidates "$dep") $(dep_search "$dep")"
        return 1
    fi
    return 0
}

# Нужен ли AppIndicator. Индикатор умеет два способа показа значка:
# Gtk.StatusIcon поверх XEmbed-трея и AppIndicator поверх протокола
# StatusNotifierItem. XEmbed есть не везде: KDE Plasma 6 его убрала, а
# wlroots-композиторы не имели никогда. Там без AppIndicator значка
# не будет вовсе, поэтому на таких системах он обязателен.
need_appindicator() {
    command -v kwin_wayland >/dev/null 2>&1 && return 0
    command -v plasmashell  >/dev/null 2>&1 && return 0
    command -v sway         >/dev/null 2>&1 && return 0
    command -v Hyprland     >/dev/null 2>&1 && return 0
    local d="${XDG_CURRENT_DESKTOP:-}${DESKTOP_SESSION:-}"
    case "${d,,}" in
        *kde*|*plasma*|*sway*|*hyprland*) return 0 ;;
    esac
    return 1
}

# Нужен ли gtk-layer-shell. Меню индикатора рисуется силами GTK, а на
# Wayland всплывающему окну нужен родитель — обычное окно на экране.
# Окно-якорь для этого есть, но координаты себе оно не выбирает:
# композитор ставит его по-своему, а wlroots ещё и берёт в раскладку,
# сдвигая соседние окна. Layer-shell делает якорь слоевой поверхностью:
# в раскладку не попадает, отступы задаются — меню встаёт под значком.
# На GNOME и KDE своя механика, там библиотека не нужна.
need_layershell() {
    command -v sway         >/dev/null 2>&1 && return 0
    command -v Hyprland     >/dev/null 2>&1 && return 0
    command -v river        >/dev/null 2>&1 && return 0
    command -v wayfire      >/dev/null 2>&1 && return 0
    local d="${XDG_CURRENT_DESKTOP:-}${DESKTOP_SESSION:-}"
    case "${d,,}" in
        *sway*|*hyprland*|*river*|*wayfire*|*niri*) return 0 ;;
    esac
    return 1
}

# Есть ли вообще графическая сессия. На сервере без графики индикатор
# показывать негде, и тянуть ради него GTK смысла нет.
has_graphics() {
    [ -d /usr/share/xsessions ] && return 0
    [ -d /usr/share/wayland-sessions ] && return 0
    [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && return 0
    return 1
}

# --- 1. зависимости ---
# Здесь временно снимаем errexit/pipefail: подбор пакетов перебирает
# кандидатов и опрашивает репозитории (apt-cache search и т.п.), а эти
# команды штатно возвращают ненулевой код (пакет не найден, пусто в
# пайпе). При `set -e` это обрывало установщик «на 3-й зависимости».
# Все реальные сбои и так учитываются через FAILED — строгий режим тут
# только мешает. После блока строгость возвращаем.
set +e +o pipefail
echo "$(t s1)"
FAILED=""
for d in evdev xlib dialog dict-ru dict-en; do
    ensure_dep "$d" || FAILED="$FAILED $d"
done

# Индикатор — часть программы, а не довесок. Если графическая сессия
# есть, его зависимости обязательны: молча поставить autoswitch без
# значка в трее хуже, чем честно остановиться и сказать, чего не хватает.
if has_graphics; then
    for d in gi gtk3; do
        ensure_dep "$d" || FAILED="$FAILED $d"
    done
    if need_appindicator; then
        echo "$(t dep_appind_req)"
        ensure_dep appind || FAILED="$FAILED appind"
    else
        # здесь работает Gtk.StatusIcon, AppIndicator лишь про запас
        ensure_dep appind optional || true
    fi
    if need_layershell; then
        echo "$(t dep_lshell_req)"
        ensure_dep lshell || FAILED="$FAILED lshell"
    fi
    # Своё окно для меню asc. Необязательно: не встало — asc откроется
    # в системном терминале, как раньше.
    ensure_dep vte optional || true
    # Снимок плитки под курсором при перетаскивании. Без pycairo GTK не
    # принимает поверхность, и вместо плитки едет значок программы —
    # работать не мешает, поэтому зависимость необязательная.
    ensure_dep cairo optional || true
else
    echo "$(t dep_nogfx)"
fi
# вернуть строгий режим для остальной установки
set -e -o pipefail

if [ -n "$FAILED" ]; then
    echo
    echo "$(t dep_fail_hdr)$FAILED"
    echo "$(t dep_fail_tip)"
    exit 1
fi

# --- 1b. словари на ожидаемом месте ---
# Движок обращается по фиксированному пути. Если дистрибутив положил
# словарь в другое место, ставим туда символьную ссылку.
link_dic() {
    local lang="$1" src dst="/usr/share/hunspell/$1.dic"
    src="$(find_dic "$lang")" || return 1
    [ "$src" = "$dst" ] && return 0
    mkdir -p /usr/share/hunspell
    ln -sf "$src" "$dst"
    # рядом лежит .aff — он тоже нужен hunspell-совместимым читалкам
    local asrc="${src%.dic}.aff"
    [ -f "$asrc" ] && ln -sf "$asrc" "/usr/share/hunspell/$lang.aff"
    tf link "$dst" "$src"
}
link_dic ru_RU || true
link_dic en_US || true

# --- 2. модуль uinput ---
echo "$(t s2)"
modprobe uinput 2>/dev/null || true
mkdir -p /etc/modules-load.d
echo "uinput" > /etc/modules-load.d/autoswitch-uinput.conf

