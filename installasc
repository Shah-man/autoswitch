        arch:evdev)   echo "python-evdev" ;;
        arch:xlib)    echo "python-xlib" ;;
        arch:gi)      echo "python-gobject" ;;
        arch:gtk3)    echo "gtk3" ;;
        arch:appind)  echo "libayatana-appindicator" ;;
        arch:lshell)  echo "gtk-layer-shell" ;;
        arch:vte)     echo "vte3" ;;
