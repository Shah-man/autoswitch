#!/usr/bin/env bash
# installasc — установщик autoswitch. Работает на любой системе с systemd.
#
# Зависимости ставятся сами, имена пакетов подбираются под дистрибутив.
# Поддержаны: ALT Linux, Debian/Ubuntu/Kali, Fedora/RHEL, Arch, openSUSE.
# На ALT пакеты запрашиваются по возможностям RPM — python3(evdev),
# typelib(Gtk) и путям файлов словарей. Так надёжнее: имена пакетов
# от версии к версии меняются, а возможности остаются.
set -euo pipefail

# ── язык интерфейса ────────────────────────────────────────────────────
# Выбор ОДНОЙ клавишей: 1 = русский, 2 = English — установка стартует сразу
# после нажатия, без Enter. В неинтерактивном режиме (пайп, cron, массовая
# корпоративная раскатка — нет терминала на входе) вопрос не задаётся и
# берётся АНГЛИЙСКИЙ по умолчанию, чтобы развёртывание не зависало на
# приглашении. Принудительно: ASC_LANG=ru|en ./installasc
UILANG=en
choose_lang() {
    case "${ASC_LANG:-}" in ru|en) UILANG="$ASC_LANG"; return ;; esac
    if [ ! -t 0 ]; then UILANG=en; return; fi
    printf 'Язык / Language:  [1] Русский   [2] English : '
    local k
    IFS= read -rsn1 k
    echo
    case "$k" in
        1) UILANG=ru ;;
        *) UILANG=en ;;
    esac
}

