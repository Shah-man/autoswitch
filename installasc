# Папка журнала — рядом с исходниками, в домашнем каталоге пользователя:
# так лог видно и можно открыть, скопировать или удалить без sudo.
# Служба работает от root, но владельцем файла делаем пользователя.
_lu="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
_lh="$(getent passwd "$_lu" | cut -d: -f6)"
if [ -n "$_lh" ] && [ "$_lu" != root ]; then
    _ld="$_lh/Applications/autoswitch.logs"
    mkdir -p "$_ld" 2>/dev/null || true
    touch "$_ld/autoswitch.log" 2>/dev/null || true
    chown -R "$_lu:" "$_ld" 2>/dev/null || true
    chmod 640 "$_ld/autoswitch.log" 2>/dev/null || true
fi
install -m 755 "$SRC/asc"             "$BINDIR/asc"
install -m 755 "$SRC/asc-gui"         "$BINDIR/asc-gui"
install -m 755 "$SRC/asc-helper"      "$BINDIR/asc-helper"
# polkit action: разрешает asc-helper без пароля активному локальному
# пользователю (правка конфига/словаря из GUI без ввода пароля каждый раз)
if [ -f "$SRC/org.autoswitch.helper.policy" ] && [ -d /usr/share/polkit-1 ]; then
    mkdir -p "$POLKITACTDIR"
    install -m 644 "$SRC/org.autoswitch.helper.policy" \
        "$POLKITACTDIR/org.autoswitch.helper.policy"
fi
# Конфиг генерируем из единого двуязычного шаблона (config_template.py) на
# языке установки. Если конфиг уже был (обновление) — сохраняем значения
# пользователя, но перевыпускаем комментарии и структуру: так добавляются
# новые ключи и уходят устаревшие (switch_hotkey, priority_layout) без
# ручного sed по каждому. Значения ui_lang и прочие берутся из старого.
GEN="$LIBDIR/config_template.py"
# Язык конфига и интерфейса = язык, выбранный СЕЙЧАС в установщике. При
# установке поверх старого — перебиваем: выбрал английский в установщике,
# значит и конфиг, и меню на английском, независимо от прежнего выбора.
if [ -f "$CFGDIR/config" ]; then
    python3 "$GEN" render "$UILANG" "$CFGDIR/config" > "$CFGDIR/config.new" \
        && mv -f "$CFGDIR/config.new" "$CFGDIR/config"
else
    python3 "$GEN" render "$UILANG" > "$CFGDIR/config"
fi
chmod 644 "$CFGDIR/config"
# ui_lang = язык установки, чтобы меню asc/индикатор были на нём, а не
# падали на автоопределение по системной локали.
if grep -qE '^ui_lang=' "$CFGDIR/config" 2>/dev/null; then
    sed -i "s#^ui_lang=.*#ui_lang=${UILANG}#" "$CFGDIR/config"
else
    printf 'ui_lang=%s\n' "$UILANG" >> "$CFGDIR/config"
fi
[ -f "$CFGDIR/user_words.txt" ] || \
    echo "# autoswitch user words (one per line)" > "$CFGDIR/user_words.txt"

# «Мой словарь»: learned.txt (US-форма<TAB>ru|us). Заменяет старый
# user_words.txt как пользовательский источник исключений. Создаём файл и
# один раз переносим накопленные user_words (они означали «считать
# английским» → язык us).
if [ ! -f "$CFGDIR/learned.txt" ]; then
    {
        echo "# autoswitch: мой словарь (US-форма<TAB>ru|us)."
        echo "# Пополняется автоматически при отмене исправлений и вручную."
        if [ -f "$CFGDIR/user_words.txt" ]; then
            # grep -v при НУЛЕ строк на выходе (в user_words.txt только
            # комментарии — как на чистой установке) возвращает код 1.
            # В пайпе под `set -e -o pipefail` это РОНЯЛО установщик на
            # шаге [3/9] — и всегда на чистой системе (файл только что создан
            # пустым), а со второго раза learned.txt уже был и весь блок
            # пропускался. Глушим код grep через `|| true`.
            { grep -vE '^[[:space:]]*(#|$)' "$CFGDIR/user_words.txt" \
                2>/dev/null || true; } \
                | while IFS= read -r w; do
                    w="$(printf '%s' "$w" | tr -d '[:space:]' | tr 'A-Z' 'a-z')"
                    [ -n "$w" ] && printf '%s\tus\n' "$w"
                done
        fi
    } > "$CFGDIR/learned.txt"
    chmod 644 "$CFGDIR/learned.txt"
    # Подсчёт перенесённых слов. grep -c при нуле совпадений тоже даёт код 1;
    # глушим и гарантируем, что migrated — всегда число.
    migrated="$(grep -cvE '^[[:space:]]*(#|$)' "$CFGDIR/learned.txt" 2>/dev/null)" || migrated=0
    [ -z "$migrated" ] && migrated=0
    if [ "$migrated" -gt 0 ] 2>/dev/null; then
        tf migrated "$migrated"
    fi
fi

# --- готовый файл настроек: применяем ---
# Файл найден ещё до выбора языка (см. find_preset выше). Применяем его
# ТОЛЬКО сейчас, когда конфиг и словарь уже созданы: настройки из файла
# кладутся поверх свежих, словарь сливается — свои слова остаются,
# принесённые добавляются и при совпадении перекрывают.
if [ -n "$PRESET" ]; then
    tf preset_found "$(basename "$PRESET")"
    [ -n "$PRESET_LANG" ] && tf preset_lang "$UILANG"
    _pc="$(mktemp)"; _pl="$(mktemp)"
    awk '/^\[config\]$/  { s = "c"; next }
         /^\[learned\]$/ { s = "l"; next }
         s == "c" { print > C }
         s == "l" { print > L }' C="$_pc" L="$_pl" "$PRESET"
    # Настройки не копируем как есть, а прогоняем через шаблон: значения
    # берутся из файла, а ключи, появившиеся в новых версиях, добавляются
    # со значениями по умолчанию, и пояснения встают на языке установки.
    if [ -s "$_pc" ]; then
        if python3 "$GEN" render "$UILANG" "$_pc" > "$CFGDIR/config.new" 2>/dev/null; then
            mv -f "$CFGDIR/config.new" "$CFGDIR/config"
        else
            rm -f "$CFGDIR/config.new"
            cp -f "$_pc" "$CFGDIR/config"
        fi
        chmod 644 "$CFGDIR/config"
        # ui_lang мог прийти пустым — ставим тот, с которым идёт установка
        if grep -qE '^ui_lang=' "$CFGDIR/config" 2>/dev/null; then
            sed -i "s#^ui_lang=.*#ui_lang=${UILANG}#" "$CFGDIR/config"
        else
            printf 'ui_lang=%s\n' "$UILANG" >> "$CFGDIR/config"
        fi
        echo "$(t preset_cfg)"
    fi
    _added="$(python3 - "$CFGDIR/learned.txt" "$_pl" <<'PYEOF'
import sys

dst, inc = sys.argv[1], sys.argv[2]


def read(path):
    words, head = {}, []
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            for line in f:
                line = line.strip()
                if line.startswith('#'):
                    head.append(line)
                    continue
                if not line:
                    continue
                parts = line.replace('\t', ' ').split()
                if not parts:
                    continue
                lang = parts[1].lower() if len(parts) > 1 else 'us'
                words[parts[0].lower()] = lang if lang in ('ru', 'us') else 'us'
    except OSError:
        pass
    return words, head


cur, head = read(dst)
new, _ = read(inc)
added = sum(1 for w in new if w not in cur)
cur.update(new)
if not head:
    head = ['# autoswitch: мой словарь (US-форма<TAB>ru|us).']
try:
    with open(dst, 'w', encoding='utf-8') as f:
        for line in head:
            f.write(line + '\n')
        for word in sorted(cur):
            f.write('%s\t%s\n' % (word, cur[word]))
except OSError:
    added = 0
print(added)
PYEOF
)" || _added=0
    [ -z "$_added" ] && _added=0
    chmod 644 "$CFGDIR/learned.txt" 2>/dev/null || true
    if [ "$_added" -gt 0 ] 2>/dev/null; then
        tf preset_words "$_added"
    fi
    rm -f "$_pc" "$_pl"
fi

# --- 4. ярлык и иконка ---
echo "$(t s4)"
mkdir -p "$APPDIR" "$ICONDIR"
install -m 644 "$SRC/autoswitch.desktop" "$APPDIR/autoswitch.desktop"
# Иконка ставится ТОЛЬКО растровыми PNG во все размеры hicolor.
# SVG намеренно не устанавливаем: наш autoswitch.svg — это растр внутри
# SVG-обёртки (не настоящий вектор), и GNOME при масштабировании такого
# SVG мылит зубцы. Готовые PNG (LANCZOS из оригинала 2048) чётче на всех
# размерах, и система выбирает ближайший сама.
for _sz in 16 22 24 32 48 64 96 128 192 256 512; do
    _dir="/usr/share/icons/hicolor/${_sz}x${_sz}/apps"
    _png="$SRC/icons/autoswitch_${_sz}.png"
    if [ -f "$_png" ]; then
        mkdir -p "$_dir"
        install -m 644 "$_png" "$_dir/autoswitch.png"
    fi
    # отдельная иконка окна настроек индикатора: та же плитка и шестерёнка,
    # но с камнем вместо букв — чтобы окна различались в панели задач
    _png2="$SRC/icons/autoswitch-indicator_${_sz}.png"
    if [ -f "$_png2" ]; then
        mkdir -p "$_dir"
        install -m 644 "$_png2" "$_dir/autoswitch-indicator.png"
    fi
done
# подчистим ранее установленный растровый SVG, если он остался от прошлых версий
rm -f "$ICONDIR/autoswitch.svg" 2>/dev/null || true

# --- 5. индикатор в трее ---
# На GNOME его заменяет расширение оболочки (в .desktop стоит
# NotShowIn=GNOME), на Plasma — апплет панели. Ставить GTK-индикатор
# рядом с ними нельзя: в трее окажется два значка сразу.
echo "$(t s5)"

have_plasma() {
    command -v plasmashell >/dev/null 2>&1 || command -v kwin_wayland >/dev/null 2>&1
}

# Апплет панели ставится в профиль пользователя (~/.local/share/plasma),
# а установщик работает от root. Поэтому запускаем его установку от имени
# того, кто вызвал sudo, и подкладываем переменные сессии: без них
# kpackagetool6 не найдёт профиль, а добавление значка в лоток не сможет
# достучаться до шины D-Bus.
run_as_user() {
    local u uid
    u="${SUDO_USER:-}"
    [ -n "$u" ] && [ "$u" != root ] || return 1
    uid="$(id -u "$u" 2>/dev/null)" || return 1
    [ -n "$uid" ] || return 1

    local -a envv
    envv=(
        "HOME=$(getent passwd "$u" | cut -d: -f6)"
        "USER=$u"
        "XDG_RUNTIME_DIR=/run/user/$uid"
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus"
    )

    # Без адреса дисплея запущенная отсюда программа видит другую сессию,
    # чем та, в которой сидит пользователь: GTK не получает от портала ни
    # темы, ни настроек, и индикатор, поднятый установщиком, выглядел
    # иначе, чем запущенный вручную — светлым меню при тёмной системе.
    # Имя сокета Wayland берём из runtime-каталога: оно не всегда
    # wayland-0, у Hyprland часто wayland-1.
    local sock
    for sock in /run/user/"$uid"/wayland-*; do
        case "$sock" in *.lock) continue ;; esac
        [ -S "$sock" ] || continue
        envv+=("WAYLAND_DISPLAY=${sock##*/}")
        break
    done
    [ -n "${DISPLAY:-}" ] && envv+=("DISPLAY=$DISPLAY")
    [ -n "${XDG_CURRENT_DESKTOP:-}" ] && \
        envv+=("XDG_CURRENT_DESKTOP=$XDG_CURRENT_DESKTOP")
    [ -n "${XDG_SESSION_TYPE:-}" ] && \
        envv+=("XDG_SESSION_TYPE=$XDG_SESSION_TYPE")

    if command -v runuser >/dev/null 2>&1; then
        runuser -u "$u" -- env "${envv[@]}" "$@"
    else
        sudo -u "$u" env "${envv[@]}" "$@"
    fi
}

# Каталог апплета может лежать рядом под разными именами: внутри общей
# сборки это plasmoid/, а при отдельной распаковке — autoswitch-plasmoid/.
PLASMOID_DIR=""
for d in "$SRC/plasmoid" "$SRC/autoswitch-plasmoid" "$SRC/../plasmoid"; do
    [ -d "$d" ] && { PLASMOID_DIR="$d"; break; }
done

# Решает именно наличие Plasma, а не наличие каталога апплета: если
# поставить сюда GTK-индикатор, в трее окажется два значка сразу.
if have_plasma; then
    echo "$(t plasma_noind)"
    # старый GTK-индикатор мог остаться от прежней установки
    rm -f "$AUTOSTARTDIR/autoswitch-indicator.desktop"
    rm -f "$APPDIR/autoswitch-indicator.desktop"
    rm -f "$BINDIR/autoswitch-indicator"
    pkill -f autoswitch-indicator 2>/dev/null || true
    # правило polkit нужно и апплету: он тоже дёргает systemctl
    if [ -f "$SRC/autoswitch-polkit.rules" ] && [ -d /etc/polkit-1 ]; then
        mkdir -p "$POLKITDIR"
        install -m 644 "$SRC/autoswitch-polkit.rules" \
            "$POLKITDIR/49-autoswitch.rules"
    fi
    # --- мост активного окна ---
    # Без него на Plasma Wayland не работают исключения приложений: KWin
    # знает класс активного окна, но наружу его не отдаёт. Скрипт внутри
    # KWin толкает класс приёмнику, приёмник хранит, движок спрашивает.
    if [ -f "$SRC/autoswitch-focus-bridge" ]; then
        install -m 755 "$SRC/autoswitch-focus-bridge" \
            "$BINDIR/autoswitch-focus-bridge"
        if [ -f "$SRC/autoswitch-focus-bridge.desktop" ]; then
            mkdir -p "$AUTOSTARTDIR"
            install -m 644 "$SRC/autoswitch-focus-bridge.desktop" \
                "$AUTOSTARTDIR/autoswitch-focus-bridge.desktop"
        fi

        KWIN_SRC=""
        for d in "$SRC/kwin-script/autoswitch" "$SRC/../kwin-script/autoswitch"; do
            [ -d "$d" ] && { KWIN_SRC="$d"; break; }
        done

        if [ -n "$KWIN_SRC" ] && [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != root ]; then
            KWIN_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
            KWIN_DIR="$KWIN_HOME/.local/share/kwin/scripts/autoswitch"
            rm -rf "$KWIN_DIR"
            mkdir -p "$(dirname "$KWIN_DIR")"
            cp -r "$KWIN_SRC" "$KWIN_DIR"
            chown -R "$SUDO_USER:" "$KWIN_HOME/.local/share/kwin" 2>/dev/null || true

            # KWin читает список включённых скриптов из kwinrc; без этой
            # записи файл просто лежит и не выполняется
            if command -v kwriteconfig6 >/dev/null 2>&1; then
                run_as_user kwriteconfig6 --file kwinrc \
                    --group Plugins --key autoswitchEnabled true \
                    >/dev/null 2>&1 || true
            fi
            # перечитать настройки, иначе скрипт запустится только со
            # следующим входом в сессию
            run_as_user gdbus call --session -d org.kde.KWin -o /KWin \
                -m org.kde.KWin.reconfigure >/dev/null 2>&1 || true
            echo "$(t kwin_ok)"
        fi

        # поднять приёмник прямо сейчас: автозапуск сработает только при
        # следующем входе в сессию
        pkill -f autoswitch-focus-bridge 2>/dev/null || true
        if command -v systemd-run >/dev/null 2>&1; then
            run_as_user systemd-run --user --quiet \
                --unit=autoswitch-focus-bridge \
                "$BINDIR/autoswitch-focus-bridge" >/dev/null 2>&1 || true
        else
            run_as_user setsid -f "$BINDIR/autoswitch-focus-bridge" \
                >/dev/null 2>&1 || true
        fi
    fi

    # ставим апплет сразу, чтобы не заставлять запускать вторую команду
    if [ -n "$PLASMOID_DIR" ] && [ -x "$PLASMOID_DIR/install-plasmoid" ]; then
        tf applet_do "${SUDO_USER:-?}"
        # вывод не глушим: по нему видно, куда апплет реально встал.
        # Раньше он уходил в /dev/null, и место установки приходилось
        # угадывать по внешнему виду панели.
        if run_as_user "$PLASMOID_DIR/install-plasmoid" 2>&1 | sed 's/^/      /'
        then
            PLASMOID_HINT=0
        else
            echo "$(t applet_auto_fail)"
            PLASMOID_HINT=1
        fi
    else
        PLASMOID_HINT=1
    fi
elif [ -f "$SRC/autoswitch-indicator" ] && has_graphics; then
    install -m 755 "$SRC/autoswitch-indicator" "$BINDIR/autoswitch-indicator"
    if [ -f "$SRC/autoswitch-indicator.desktop" ]; then
        install -m 644 "$SRC/autoswitch-indicator.desktop" \
            "$APPDIR/autoswitch-indicator.desktop"
        mkdir -p "$AUTOSTARTDIR"
        install -m 644 "$SRC/autoswitch-indicator.desktop" \
            "$AUTOSTARTDIR/autoswitch-indicator.desktop"
    fi
    # правило polkit: кнопки Старт/Стоп/Перезапуск без пароля
    if [ -f "$SRC/autoswitch-polkit.rules" ] && [ -d /etc/polkit-1 ]; then
        mkdir -p "$POLKITDIR"
        install -m 644 "$SRC/autoswitch-polkit.rules" \
            "$POLKITDIR/49-autoswitch.rules"
    fi
    # Уже запущенный индикатор держит в памяти прежнюю версию: файл на
    # диске обновился, а окно настроек и значок остались старыми. Служба
    # перезапускается сама, а индикатор — нет, поэтому перезапускаем его
    # здесь, иначе после каждого обновления это пришлось бы делать руками.
    if pgrep -f autoswitch-indicator >/dev/null 2>&1; then
        pkill -f autoswitch-indicator 2>/dev/null || true
        sleep 0.5
        MSG="$(t ind_restarted)"
    else
        MSG="$(t ind_started)"
    fi
    # Запускаем в любом случае: раньше значок поднимался только если уже
    # работал, а после первой установки на живой сессии его приходилось
    # ждать до перезахода или звать руками.
    run_as_user setsid -f "$BINDIR/autoswitch-indicator" >/dev/null 2>&1 \
        || run_as_user "$BINDIR/autoswitch-indicator" >/dev/null 2>&1 &
    echo "    $MSG"
elif [ ! -f "$SRC/autoswitch-indicator" ]; then
    echo "$(t ind_nofile)"
else
    echo "$(t ind_nogfx)"
fi

# --- 6. расширение GNOME Shell ---
# На Wayland движок не может ни переключить раскладку, ни узнать класс
# активного окна: это умеет только сама оболочка. Расширение — не
# украшение, без него autoswitch в GNOME Wayland работать не будет,
# поэтому ставится вместе со всем остальным, а не отдельной командой.
echo "$(t s6)"

EXT_UUID="autoswitch@shah-man.github.io"
EXT_SRC=""
for d in "$SRC/gnome-extension/$EXT_UUID" "$SRC/../gnome-extension/$EXT_UUID"; do
    [ -d "$d" ] && { EXT_SRC="$d"; break; }
done

GNOME_USER="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
GNOME_HOME="$(getent passwd "$GNOME_USER" | cut -d: -f6)"

if ! command -v gnome-shell >/dev/null 2>&1; then
    echo "$(t gs_notfound)"
elif [ -z "$EXT_SRC" ]; then
    echo "$(t ext_nobuild)"
elif [ -z "$GNOME_HOME" ] || [ "$GNOME_USER" = root ]; then
    echo "$(t ext_nouser)"
else
    EXT_DIR="$GNOME_HOME/.local/share/gnome-shell/extensions/$EXT_UUID"
    if [ -d "$EXT_DIR" ]; then
        # gschemas.compiled собирается на месте и в сборке его нет,
        # поэтому в сравнении он не участвует — иначе каталоги отличались
        # бы всегда и установщик на каждом запуске просил бы перезайти.
        if diff -rq --exclude=gschemas.compiled "$EXT_SRC" "$EXT_DIR" \
             >/dev/null 2>&1; then
            EXT_ACTION="$(t ext_act_same)"
        else
            EXT_ACTION="$(t ext_act_updated)"
        fi
    else
        EXT_ACTION="$(t ext_act_installed)"
    fi

    # копируем целиком, а не поверх: так уходят файлы, удалённые из сборки.
    # Скомпилированные схемы сохраняем и кладём обратно: пересобирать их
    # незачем, если сами схемы не менялись.
    KEEP_COMPILED=""
    if [ -f "$EXT_DIR/schemas/gschemas.compiled" ]; then
        KEEP_COMPILED="$(mktemp)"
        cp "$EXT_DIR/schemas/gschemas.compiled" "$KEEP_COMPILED"
    fi
    rm -rf "$EXT_DIR"
    mkdir -p "$(dirname "$EXT_DIR")"
    cp -r "$EXT_SRC" "$EXT_DIR"

    # схемы настроек нужны в скомпилированном виде, иначе окно настроек
    # расширения падает при открытии
    if [ -d "$EXT_DIR/schemas" ]; then
        if [ -n "$KEEP_COMPILED" ] && [ "$EXT_ACTION" = "уже стоит и совпадает с этой сборкой" ]; then
            install -m 644 "$KEEP_COMPILED" "$EXT_DIR/schemas/gschemas.compiled"
        elif command -v glib-compile-schemas >/dev/null 2>&1; then
            if ! glib-compile-schemas "$EXT_DIR/schemas"; then
                echo "$(t schema_warn1)"
                echo "$(t schema_warn2)"
            fi
        fi
    fi
    [ -n "$KEEP_COMPILED" ] && rm -f "$KEEP_COMPILED"

    # chown строго ПОСЛЕ компиляции схем: установщик работает от root,
    # и созданный им gschemas.compiled иначе остаётся root:root с umask 077.
    # Оболочка читает файл от имени пользователя, получает "Отказано в
    # доступе", enable() падает — и расширения на панели просто нет.
    chown -R "$GNOME_USER:" "$GNOME_HOME/.local/share/gnome-shell" 2>/dev/null || true
    if [ -f "$EXT_DIR/schemas/gschemas.compiled" ]; then
        chmod 644 "$EXT_DIR/schemas/gschemas.compiled"
    fi

    echo "    $EXT_ACTION"

    if run_as_user gnome-extensions enable "$EXT_UUID" >/dev/null 2>&1; then
        echo "$(t ext_enabled)"
    else
        echo "$(t ext_enable_later)"
        echo "      gnome-extensions enable $EXT_UUID"
    fi

    # Оболочка держит код расширения в памяти. На X11 её можно перезапустить
    # на лету, на Wayland — нет, там нужен перезаход в сессию.
    if [ "$EXT_ACTION" = "обновлено" ]; then
        EXT_RELOGIN=1
    fi
fi

command -v gtk-update-icon-cache >/dev/null 2>&1 && \
    gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
command -v update-desktop-database >/dev/null 2>&1 && \
    update-desktop-database "$APPDIR" 2>/dev/null || true

# --- 6. служба systemd ---
echo "$(t s7)"
install -m 644 "$SRC/autoswitch.service" /etc/systemd/system/autoswitch.service
REAL_USER="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"
XAUTH_PATH="${REAL_HOME:-/root}/.Xauthority"
sed -i "s|__XAUTH__|$XAUTH_PATH|" /etc/systemd/system/autoswitch.service
systemctl daemon-reload

# --- 7. запуск ---
echo "$(t s8)"
systemctl enable autoswitch >/dev/null 2>&1
systemctl restart autoswitch || true

# --- 9. каталог исходников ---
# Смысл: на любой машине исходники лежат по одному пути и всегда
# соответствуют тому, что стоит в системе. Значит переустановиться можно
# без сети — зайти туда и запустить installasc заново.
#
# Копия делается полной, с удалением лишнего: иначе файлы, выброшенные из
# проекта, оставались бы навсегда, и каталог перестал бы быть копией
# сборки. Из этого следует правило: обновлять его только целым архивом,
# частичная распаковка поверх сделает набор неполным.
echo "$(t s9)"

SRC_USER="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
SRC_HOME="$(getent passwd "$SRC_USER" | cut -d: -f6)"
KEEP_DIR="${SRC_HOME:-/root}/Applications/autoswitch"

if [ -z "$SRC_HOME" ] || [ "$SRC_USER" = root ]; then
    echo "$(t src_nohome)"
elif [ "$SRC" = "$KEEP_DIR" ]; then
    tf src_here "$KEEP_DIR"
else
    if [ -d "$KEEP_DIR" ]; then
        # одна страховочная копия: откатиться, если новая сборка окажется
        # хуже старой
        rm -rf "$KEEP_DIR.bak"
        mv "$KEEP_DIR" "$KEEP_DIR.bak"
        tf bak "$KEEP_DIR.bak"
    fi
    mkdir -p "$(dirname "$KEEP_DIR")"
    cp -r "$SRC" "$KEEP_DIR"
    # Файл настроек, если его положили рядом с установщиком, в постоянную
    # копию НЕ едет. Иначе при переустановке отсюда через полгода он
    # нашёлся бы снова и молча вернул настройки полугодовой давности,
    # затерев нынешние. Свою работу он уже сделал — при этой установке.
    rm -f "$KEEP_DIR"/autoswitch-settings-*.txt 2>/dev/null || true
    chown -R "$SRC_USER:" "${SRC_HOME}/Applications" 2>/dev/null || true
    tf src_laid "$KEEP_DIR"
fi

echo
echo "$(t done)"
echo "$(t help_menu)"
echo "$(t help_cmds)"
echo "$(t help_uninstall)"
if [ -n "${KEEP_DIR:-}" ] && [ -x "$KEEP_DIR/installasc" ]; then
    tf reinstall "$KEEP_DIR"
fi

if [ "${EXT_RELOGIN:-0}" = "1" ]; then
    echo
    echo "$(t ext_updated1)"
    echo "$(t ext_updated2)"
fi

if [ "${PLASMOID_HINT:-0}" = "1" ]; then
    echo
    if [ -n "$PLASMOID_DIR" ] && [ -x "$PLASMOID_DIR/install-plasmoid" ]; then
        echo "$(t plasmoid_todo1)"
        echo "$(t plasmoid_todo2)"
        echo "    $PLASMOID_DIR/install-plasmoid"
    else
        echo "$(t plasmoid_warn1)"
        echo "$(t plasmoid_warn2)"
        echo "$(t plasmoid_warn3)"
    fi
fi
# ─────────────────────────── проверка раскладок ───────────────────────
# Autoswitch переключает раскладку — значит их должно быть минимум две.
# С одной он установится и запустится, но переключать будет не на что, и
# со стороны это выглядит как «поставил, а оно не работает».
#
# Единого места, где лежит список раскладок, нет: GNOME держит его в
# dconf, KDE в kxkbrc, Hyprland и sway в своих конфигах, а системная
# настройка (localectl) при этом может быть совсем другой — окружения на
# неё не смотрят. Поэтому опрашиваем все источники сразу, берём
# НАИБОЛЬШЕЕ найденное число и предупреждаем, только когда все согласны,
# что раскладка одна. Не выяснили ничего — молчим: напугать зря хуже.

# Число непустых элементов списка через запятую: "us,ru" -> 2
# Кавычки и пробелы убираем, крайние запятые тоже (в lua-конфиге
# Hyprland строка заканчивается запятой, иначе она дала бы лишний +1).
csv_count() {
    local s
    s="$(printf '%s' "${1:-}" | tr -d '\042\047 ' | sed 's/^,*//; s/,*$//')"
    [ -n "$s" ] || { echo 0; return 0; }
    printf '%s' "$s" | awk -F, '{c=0; for (i=1; i<=NF; i++) if ($i != "") c++; print c}'
}

layout_count() {
    local best=0 v n u h
    u="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
    h="$(getent passwd "$u" 2>/dev/null | cut -d: -f6)"
    [ -n "$h" ] || h="$HOME"

    # 1. GNOME и всё, что хранит настройку в dconf.
    #    Значение вида: [('xkb', 'us'), ('xkb', 'ru')] — считаем записи.
    v="$(run_as_user gsettings get org.gnome.desktop.input-sources sources 2>/dev/null)"
    n="$(printf '%s' "$v" | grep -o "'[^']*')" | wc -l)"
    if [ "${n:-0}" -gt "$best" ] 2>/dev/null; then best="$n"; fi

    # 2. KDE Plasma: LayoutList=us,ru
    n="$(csv_count "$(grep -m1 '^LayoutList=' "$h/.config/kxkbrc" 2>/dev/null | cut -d= -f2)")"
    if [ "${n:-0}" -gt "$best" ] 2>/dev/null; then best="$n"; fi

    # 3. Hyprland: kb_layout = us,ru — и в старом .conf, и в новом .lua
    v="$(grep -rhm1 'kb_layout' "$h/.config/hypr" 2>/dev/null | head -1 \
         | sed 's/.*kb_layout//; s/^[[:space:]]*=//')"
    n="$(csv_count "$v")"
    if [ "${n:-0}" -gt "$best" ] 2>/dev/null; then best="$n"; fi

    # 4. sway: xkb_layout "us,ru"
    v="$(grep -rhm1 'xkb_layout' "$h/.config/sway" 2>/dev/null | head -1 \
         | sed 's/.*xkb_layout//')"
    n="$(csv_count "$v")"
    if [ "${n:-0}" -gt "$best" ] 2>/dev/null; then best="$n"; fi

    # 5. живая сессия X11 — XFCE, LXQt и прочие, где своего хранилища нет
    v="$(run_as_user env DISPLAY="${DISPLAY:-:0}" XAUTHORITY="$h/.Xauthority" \
         setxkbmap -query 2>/dev/null | awk '/^layout:/{print $2}')"
    n="$(csv_count "$v")"
    if [ "${n:-0}" -gt "$best" ] 2>/dev/null; then best="$n"; fi

    # 6. системная настройка через systemd
    v="$(localectl status 2>/dev/null | awk -F: '/X11 Layout/{print $2}')"
    n="$(csv_count "$v")"
    if [ "${n:-0}" -gt "$best" ] 2>/dev/null; then best="$n"; fi

    # 7. то же, но прямо из файла — на случай, если localectl недоступен
    v="$(grep -rhm1 'XkbLayout' /etc/X11/xorg.conf.d 2>/dev/null | head -1 \
         | sed 's/.*XkbLayout//')"
    n="$(csv_count "$v")"
    if [ "${n:-0}" -gt "$best" ] 2>/dev/null; then best="$n"; fi

    # 8. Debian и ALT: /etc/default/keyboard
    v="$(grep -m1 '^XKBLAYOUT=' /etc/default/keyboard 2>/dev/null | cut -d= -f2)"
    n="$(csv_count "$v")"
    if [ "${n:-0}" -gt "$best" ] 2>/dev/null; then best="$n"; fi

    echo "$best"
}

# Опрос источников штатно возвращает ненулевые коды (файла нет, grep не
# нашёл, команды может не быть вовсе) — строгий режим тут только мешает,
# как и в блоке зависимостей. После проверки строгость возвращаем.
set +e +o pipefail
KB_N="$(layout_count)"
set -e -o pipefail
if [ "${KB_N:-0}" = "1" ]; then
    echo
    echo "$(t kb_one1)"
    echo "$(t kb_one2)"
    echo "$(t kb_one3)"
fi

echo
sleep 1
echo
echo "$(t ses_hdr)"
# Служба пишет эту строку не в первый миг после запуска, а скрипт
# добирается до журнала почти сразу — поэтому ждём её появления, но
# недолго: если за пару секунд не написала, отсылаем к журналу.
ses_line=""
for _ in 1 2 3 4 5 6 7 8; do
    # -a обязателен: если в журнал попал хоть один нетекстовый байт,
    # grep считает весь поток двоичным, строку не отдаёт и ругается в
    # поток ошибок. Раньше из-за этого цикл прокручивался вхолостую все
    # восемь раз, печатал восемь одинаковых предупреждений, а вместо
    # строки сессии показывал запасной текст.
    ses_line="$(tail -n 40 "${_lh:-$HOME}/Applications/autoswitch.logs/autoswitch.log" \
                2>/dev/null | grep -a -E 'session=|compositor=' 2>/dev/null | tail -1)"
    [ -n "$ses_line" ] && break
    sleep 0.25
done
if [ -n "$ses_line" ]; then
    echo "$ses_line"
else
    echo "$(t ses_see)"
fi
