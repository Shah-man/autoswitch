mkdir -p "$LIBDIR" "$CFGDIR"
install -m 644 "$SRC/autoswitch.py"   "$LIBDIR/autoswitch.py"
install -m 644 "$SRC/dictionaries.py" "$LIBDIR/dictionaries.py"
install -m 644 "$SRC/tech_words.py"   "$LIBDIR/tech_words.py"
install -m 644 "$SRC/config_template.py" "$LIBDIR/config_template.py"
install -m 644 "$SRC/layout.py"       "$LIBDIR/layout.py"
# руководство: один текст на консоль и на окно, лежит рядом с движком
for _m in ru en; do
    [ -f "$SRC/manual_$_m.txt" ] && \
        install -m 644 "$SRC/manual_$_m.txt" "$LIBDIR/manual_$_m.txt"
