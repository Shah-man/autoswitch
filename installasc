        alt:xlib)     echo "python3-module-pyxlib python3(Xlib)" ;;
        alt:gi)       echo "python3-module-pygobject3 python3(gi)" ;;
        alt:gtk3)     echo "typelib(Gtk)=3.0 libgtk+3-gir" ;;
        alt:appind)   echo "typelib(AyatanaAppIndicator3)=0.1 libayatana-appindicator-gir typelib(AppIndicator3)=0.1" ;;
        alt:lshell)   echo "typelib(GtkLayerShell)=0.1 libgtk-layer-shell-gir libgtk-layer-shell" ;;
        alt:vte)      echo "typelib(Vte)=2.91 libvte3-gir" ;;
        alt:cairo)    echo "python3-module-pycairo python3(cairo) python3-module-pygobject3 python3-modules-cairo" ;;
        alt:dialog)   echo "dialog" ;;
        alt:dict-ru)  echo "/usr/share/hunspell/ru_RU.dic hunspell-ru" ;;
        alt:dict-en)  echo "/usr/share/hunspell/en_US.dic hunspell-en" ;;

        debian:evdev)   echo "python3-evdev" ;;
        debian:xlib)    echo "python3-xlib" ;;
        debian:gi)      echo "python3-gi" ;;
        debian:gtk3)    echo "gir1.2-gtk-3.0" ;;
        debian:appind)  echo "gir1.2-ayatanaappindicator3-0.1 gir1.2-appindicator3-0.1" ;;
        debian:lshell)  echo "gir1.2-gtklayershell-0.1 libgtk-layer-shell0" ;;
        debian:vte)     echo "gir1.2-vte-2.91" ;;
        debian:cairo)   echo "python3-gi-cairo python3-cairo" ;;
        debian:dialog)  echo "dialog" ;;
        debian:dict-ru) echo "hunspell-ru" ;;
