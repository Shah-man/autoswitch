        gtk3)    t dh_gtk3 ;;
        appind)  t dh_appind ;;
        lshell)  t dh_lshell ;;
        vte)     t dh_vte ;;
        cairo)   t dh_cairo ;;
        dialog)  t dh_dialog ;;
        dict-ru) t dh_dictru ;;
