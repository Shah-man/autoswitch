# ---------- готовый файл настроек рядом с установщиком ----------
# Смысл: поставить сразу с нужными настройками, ничего не вводя руками.
# На образцовой машине делается экспорт (asc → Настройки → Экспорт), файл
# кладётся рядом с установщиком — и на остальных машинах установка идёт
# одной командой. Файла нет — всё как раньше, ни одного лишнего вопроса.
# Ищем в двух местах: рядом со скриптом и там, откуда его запустили —
# файл могли положить и внутрь распакованной папки, и рядом с архивом.
PRESET=""
find_preset() {
    local d f
    for d in "$SRC" "$PWD"; do
        [ -d "$d" ] || continue
        for f in "$d"/autoswitch-settings-*.txt; do
            [ -r "$f" ] || continue
            # первая строка — метка экспорта, иначе это чужой файл
            head -1 "$f" | grep -q '^# autoswitch settings export' || continue
            PRESET="$f"
            return 0
        done
    done
    return 1
}

# Язык из найденного файла. Читаем только часть [config]: в словаре ниже
# может встретиться слово, похожее на ключ.
preset_lang() {
    awk '/^\[learned\]$/ { exit }
         /^ui_lang=/ { sub(/^ui_lang=/, ""); gsub(/[ \t\r]/, ""); print; exit }' \
        "$PRESET" 2>/dev/null
}

do_uninstall() {
    echo "$(t un_title)"
    DESK_USER="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
    DESK_HOME="$(getent passwd "$DESK_USER" | cut -d: -f6)"
    EXT_UUID="autoswitch@shah-man.github.io"

# --- служба ---
systemctl stop autoswitch 2>/dev/null || true
systemctl disable autoswitch 2>/dev/null || true
rm -f /etc/systemd/system/autoswitch.service
systemctl daemon-reload 2>/dev/null || true

# --- индикатор ---
# он запускается в сессии пользователя, поэтому сначала снимаем работающий
pkill -f autoswitch-indicator 2>/dev/null || true
rm -f /usr/local/bin/autoswitch-indicator
rm -f /usr/share/applications/autoswitch-indicator.desktop
rm -f /etc/xdg/autostart/autoswitch-indicator.desktop
rm -f /etc/polkit-1/rules.d/49-autoswitch.rules
rm -f /usr/share/polkit-1/actions/org.autoswitch.helper.policy

# --- расширение GNOME и апплет Plasma ---
# Оба живут в профиле пользователя, а скрипт работает от root, поэтому
# путь берём у того, кто вызвал sudo.

# Запуск команды в сессии пользователя: и gnome-extensions, и dconf, и
# kpackagetool6 ходят на шину сеанса, от root они её не видят.
run_as_user() {
    local uid
    uid="$(id -u "$DESK_USER" 2>/dev/null)" || return 1
    [ -n "$uid" ] || return 1
    local envv=(
        "HOME=$DESK_HOME"
        "XDG_RUNTIME_DIR=/run/user/$uid"
        "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus"
    )
    if command -v runuser >/dev/null 2>&1; then
        runuser -u "$DESK_USER" -- env "${envv[@]}" "$@"
    else
        sudo -u "$DESK_USER" env "${envv[@]}" "$@"
    fi
}

if [ -n "$DESK_HOME" ] && [ "$DESK_USER" != root ]; then
    EXT_DIR="$DESK_HOME/.local/share/gnome-shell/extensions/$EXT_UUID"
    if [ -d "$EXT_DIR" ]; then
        # Сначала выключаем, потом удаляем каталог. Иначе UUID остаётся в
        # ключе enabled-extensions, и оболочка ругается на расширение,
        # которого уже нет на диске.
        if command -v gnome-extensions >/dev/null 2>&1; then
            run_as_user gnome-extensions disable "$EXT_UUID" >/dev/null 2>&1 || true
        fi
        rm -rf "$EXT_DIR"
        echo "$(t un_ext_removed)"
    fi

    # KWin-скрипт и его приёмник
    KWIN_DIR="$DESK_HOME/.local/share/kwin/scripts/autoswitch"
    if [ -d "$KWIN_DIR" ]; then
        if command -v kwriteconfig6 >/dev/null 2>&1; then
            run_as_user kwriteconfig6 --file kwinrc \
                --group Plugins --key autoswitchEnabled false >/dev/null 2>&1 || true
        fi
        rm -rf "$KWIN_DIR"
        run_as_user gdbus call --session -d org.kde.KWin -o /KWin \
            -m org.kde.KWin.reconfigure >/dev/null 2>&1 || true
        echo "$(t un_kwin_removed)"
    fi

    run_as_user systemctl --user stop autoswitch-focus-bridge >/dev/null 2>&1 || true
    pkill -f autoswitch-focus-bridge 2>/dev/null || true

    if command -v kpackagetool6 >/dev/null 2>&1; then
        run_as_user kpackagetool6 --type Plasma/Applet \
            --remove org.shah-man.autoswitch >/dev/null 2>&1 \
            && echo "$(t un_plasmoid_removed)"
    fi
fi

rm -f /usr/local/bin/autoswitch-focus-bridge
