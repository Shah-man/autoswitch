    read -r ans
    case "$ans" in
        y|Y|д|Д)
            rm -rf /etc/autoswitch
            # журнал с набранными словами тоже убираем
            [ -n "$DESK_HOME" ] && rm -rf "$DESK_HOME/Applications/autoswitch.logs"
            [ -n "$IND_CFG" ] && rm -rf "$IND_CFG"
            # значения расширения живут в dconf и переживают удаление файлов
            if command -v dconf >/dev/null 2>&1; then
                run_as_user dconf reset -f \
                    /org/gnome/shell/extensions/autoswitch/ >/dev/null 2>&1 || true
            fi
            echo "$(t un_cfg_removed)"
            ;;
        *)  echo "$(t un_cfg_kept)" ;;
    esac
fi

echo "$(t un_done)"
    exit 0
}

