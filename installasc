    local fmt
    case "$key:$UILANG" in
        preset_found:ru) fmt='  найден файл настроек: %s\n' ;;
        preset_found:en) fmt='  settings file found: %s\n' ;;
        preset_lang:ru)  fmt='    язык взят из файла: %s\n' ;;
        preset_lang:en)  fmt='    language taken from the file: %s\n' ;;
        preset_words:ru) fmt='    словарь: добавлено слов: %s\n' ;;
        preset_words:en) fmt='    dictionary: words added: %s\n' ;;
        distro:ru)     fmt='  дистрибутив: %s\n' ;;
        distro:en)     fmt='  distribution: %s\n' ;;
        dep_have:ru)   fmt='    уже есть: %s\n' ;;
        dep_have:en)   fmt='    already present: %s\n' ;;
        dep_inst:ru)   fmt='    установлено: %s  [%s]\n' ;;
        dep_inst:en)   fmt='    installed: %s  [%s]\n' ;;
        dep_skip:ru)   fmt='    ПРОПУЩЕНО (необязательно): %s\n' ;;
        dep_skip:en)   fmt='    SKIPPED (optional): %s\n' ;;
        dep_nfail:ru)  fmt='    НЕ УДАЛОСЬ: %s\n' ;;
        dep_nfail:en)  fmt='    FAILED: %s\n' ;;
        dep_tried:ru)  fmt='      попробованы пакеты: %s\n' ;;
        dep_tried:en)  fmt='      tried packages: %s\n' ;;
        link:ru)       fmt='    ссылка: %s -> %s\n' ;;
        link:en)       fmt='    symlink: %s -> %s\n' ;;
        migrated:ru)   fmt='    в «Мой словарь» (learned.txt) перенесено слов: %s\n' ;;
        migrated:en)   fmt='    words migrated into "My dictionary" (learned.txt): %s\n' ;;
        applet_do:ru)  fmt='    ставлю апплет панели от имени %s:\n' ;;
        applet_do:en)  fmt='    installing panel applet as %s:\n' ;;
        bak:ru)        fmt='    прежнее содержимое: %s\n' ;;
        bak:en)        fmt='    previous content: %s\n' ;;
