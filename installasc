        fedora:evdev)   echo "python3-evdev" ;;
        fedora:xlib)    echo "python3-xlib" ;;
        fedora:gi)      echo "python3-gobject" ;;
        fedora:gtk3)    echo "gtk3" ;;
        fedora:appind)  echo "libayatana-appindicator-gtk3" ;;
        fedora:lshell)  echo "gtk-layer-shell" ;;
        fedora:vte)     echo "vte291-gtk3" ;;
        fedora:cairo)   echo "python3-gobject python3-cairo" ;;
        fedora:dialog)  echo "dialog" ;;
        fedora:dict-ru) echo "hunspell-ru" ;;
